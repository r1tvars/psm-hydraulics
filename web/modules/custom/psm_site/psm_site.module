<?php

declare(strict_types=1);

/**
 * @file
 * Site-specific hooks for PSM Hydraulics.
 */

use Drupal\Core\Form\FormStateInterface;
use Drupal\Core\Render\Element;
use Drupal\Core\Url;
use Drupal\taxonomy\VocabularyInterface;
use Drupal\views\Plugin\views\query\QueryPluginBase;
use Drupal\views\ViewExecutable;

/**
 * Implements hook_form_FORM_ID_alter() for taxonomy_overview_terms.
 *
 * Adds a "Products" column to the product category overview, so editors can
 * see what each category actually holds before renaming, re-parenting or
 * deleting it. Unpublished products are counted too: the question this
 * answers is "is anything still filed here?".
 */
function psm_site_form_taxonomy_overview_terms_alter(array &$form, FormStateInterface $form_state): void {
  // OverviewTerms::buildForm() receives the vocabulary, so it is in the build
  // args whether the form came from the route or was built directly.
  $vocabulary = $form_state->getBuildInfo()['args'][0] ?? NULL;
  if (!$vocabulary instanceof VocabularyInterface || $vocabulary->id() !== 'product_category') {
    return;
  }
  if (!isset($form['terms']['#header'])) {
    return;
  }

  $direct = _psm_site_product_category_counts();
  $subtree = _psm_site_product_category_subtree_counts($direct);

  // Insert the column straight after the term name.
  $header = [];
  foreach ($form['terms']['#header'] as $name => $label) {
    $header[$name] = $label;
    if ($name === 'term') {
      $header['products'] = t('Products');
    }
  }
  $form['terms']['#header'] = $header;

  foreach (Element::children($form['terms']) as $key) {
    if (!preg_match('/^tid:(\d+):0$/', $key, $matches)) {
      continue;
    }
    $tid = (int) $matches[1];
    $own = $direct[$tid] ?? 0;
    $total = $subtree[$tid] ?? $own;

    $label = (string) $own;
    if ($total > $own) {
      // A parent can hold nothing itself while its children are full.
      $label = t('@own (@total with subcategories)', ['@own' => $own, '@total' => $total]);
    }

    $cell = $own || $total
      ? [
        '#type' => 'link',
        '#title' => $label,
        '#url' => Url::fromRoute('view.products.page_1', [], ['query' => ['category' => [$tid]]]),
      ]
      : ['#markup' => '<span class="psm-term-count--empty">0</span>'];

    // Rebuild the row in order: a table element renders its cells in the
    // order the child keys appear, so appending would put the count last.
    $row = $form['terms'][$key];
    $rebuilt = array_filter($row, static fn ($name) => str_starts_with($name, '#'), ARRAY_FILTER_USE_KEY);
    foreach (Element::children($row) as $child) {
      $rebuilt[$child] = $row[$child];
      if ($child === 'term') {
        $rebuilt['products'] = $cell;
      }
    }
    if (!isset($rebuilt['products'])) {
      $rebuilt['products'] = $cell;
    }
    $form['terms'][$key] = $rebuilt;
  }

  $form['#cache']['tags'][] = 'node_list:catalogue_item';
}

/**
 * Counts catalogue items referencing each product category, published or not.
 */
function _psm_site_product_category_counts(): array {
  $query = \Drupal::database()->select('node__field_product_category', 'f');
  $query->innerJoin('node_field_data', 'n', 'n.nid = f.entity_id AND n.langcode = f.langcode');
  $query->condition('n.default_langcode', 1)
    ->condition('n.type', 'catalogue_item')
    ->condition('f.deleted', 0);
  $query->addField('f', 'field_product_category_target_id', 'tid');
  $query->addExpression('COUNT(DISTINCT f.entity_id)', 'total');
  $query->groupBy('f.field_product_category_target_id');

  $counts = [];
  foreach ($query->execute() as $row) {
    $counts[(int) $row->tid] = (int) $row->total;
  }
  return $counts;
}

/**
 * Rolls the direct counts up through the category tree.
 */
function _psm_site_product_category_subtree_counts(array $direct): array {
  $children = [];
  foreach (\Drupal::entityTypeManager()->getStorage('taxonomy_term')->loadTree('product_category') as $term) {
    $children[(int) reset($term->parents)][] = (int) $term->tid;
  }

  $totals = [];
  $walk = static function (int $tid) use (&$walk, $children, $direct, &$totals): int {
    $total = $direct[$tid] ?? 0;
    foreach ($children[$tid] ?? [] as $child) {
      $total += $walk($child);
    }
    $totals[$tid] = $total;
    return $total;
  };
  foreach ($children[0] ?? [] as $root) {
    $walk($root);
  }
  return $totals;
}

/**
 * Implements hook_views_pre_render().
 *
 * The products page head band is driven by psm_site.settings (texts,
 * background image, counter toggle), so the view's render cache must be
 * invalidated when those settings change.
 */
function psm_site_views_pre_render(ViewExecutable $view): void {
  if ($view->id() === 'products') {
    $view->element['#cache']['tags'][] = 'config:psm_site.settings';
    // Results depend on the category tree shape (parent selections match
    // whole subtrees in psm_site_views_query_alter()), so re-parenting a
    // term must invalidate the listing.
    $view->element['#cache']['tags'][] = 'taxonomy_term_list:product_category';
  }
}

/**
 * Implements hook_views_query_alter().
 *
 * The products listing exposes two filters that Views cannot provide out of
 * the box: a multi-value manufacturer filter (plain string field) and a
 * "datasheet available" toggle. Both read their input straight from the
 * query string; the products view already varies its cache by
 * url.query_args, so no extra cache metadata is needed.
 */
function psm_site_views_query_alter(ViewExecutable $view, QueryPluginBase $query): void {
  if ($view->id() !== 'products' || !$query instanceof \Drupal\views\Plugin\views\query\Sql) {
    return;
  }

  $params = \Drupal::request()->query;

  $manufacturers = array_values(array_filter(
    (array) $params->all('manufacturer'),
    static fn ($value) => is_string($value) && $value !== '',
  ));
  if ($manufacturers !== []) {
    $table = $query->ensureTable('node__field_manufacturer');
    $query->addWhere('psm_products', "$table.field_manufacturer_value", $manufacturers, 'IN');
  }

  if ($params->get('doc')) {
    $table = $query->ensureTable('node__field_datasheet');
    $query->addWhere('psm_products', "$table.field_datasheet_target_id", NULL, 'IS NOT NULL');
  }

  // The category vocabulary is hierarchical: checking a parent category must
  // match its whole subtree, but the exposed taxonomy filter (identifier
  // "category") only matches exact tids. Its ManyToOne helper renders the
  // condition as an opaque formula string, so it cannot be expanded in place;
  // instead the condition is replaced with a plain IN on the selected tids
  // plus all their descendants. Exposed input is deliberately left untouched:
  // the theme reads it to mark sidebar checkboxes and chips as selected, and
  // only the explicitly checked parent should show there.
  $categories = array_values(array_filter(
    (array) ($view->getExposedInput()['category'] ?? []),
    'is_numeric',
  ));
  if ($categories !== []) {
    $tids = array_map('intval', $categories);
    $term_storage = \Drupal::entityTypeManager()->getStorage('taxonomy_term');
    foreach ($tids as $tid) {
      foreach ($term_storage->loadTree('product_category', $tid) as $descendant) {
        $tids[] = (int) $descendant->tid;
      }
    }
    foreach ($query->where as &$group) {
      $group['conditions'] = array_values(array_filter(
        $group['conditions'],
        static fn (array $condition) => !is_string($condition['field'])
          || !str_contains($condition['field'], 'field_product_category_target_id'),
      ));
    }
    unset($group);
    // The exposed filter already ensured the node__field_product_category join.
    $query->addWhere('psm_products', 'node__field_product_category.field_product_category_target_id', array_values(array_unique($tids)), 'IN');
  }
}

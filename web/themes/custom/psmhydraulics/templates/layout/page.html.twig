{#
/**
 * @file
 * Theme override to display a single page.
 *
 * Search-first sticky header, dark primary navbar with mega menus,
 * slide-in mobile drawer and the schematic footer.
 */
#}
<div class="site-shell">
  {{ attach_library('psmhydraulics/nav') }}
  {{ attach_library('psmhydraulics/header-search') }}
  {% if psm_site_quote.modal %}
    {{ attach_library('core/drupal.dialog.ajax') }}
  {% endif %}

  {# ── Top utility bar: contacts · language · socials (desktop only) ── #}
  <div class="topbar">
    <div class="site-section">
      <div class="topbar__inner">
        <div class="topbar__info">
          {% if psm_site_contact.phone %}
            <a class="topbar__item" href="{{ psm_site_contact.phone_href }}">
              <i class="fa-solid fa-phone" aria-hidden="true"></i>
              <span>{{ psm_site_contact.phone }}</span>
            </a>
          {% endif %}
          {% if psm_site_contact.email %}
            <a class="topbar__item" href="mailto:{{ psm_site_contact.email }}">
              <i class="fa-solid fa-envelope" aria-hidden="true"></i>
              <span>{{ psm_site_contact.email }}</span>
            </a>
          {% endif %}
          {% if psm_site_contact.location %}
            <span class="topbar__item topbar__item--static">
              <i class="fa-solid fa-location-dot" aria-hidden="true"></i>
              <span>{{ psm_site_contact.location }}</span>
            </span>
          {% endif %}
        </div>

        <div class="topbar__right">
          {% if page.secondary_menu %}
            <div class="topbar__lang">
              {{ page.secondary_menu }}
            </div>
          {% endif %}
          {% if psm_site_socials %}
            <span class="topbar__sep" aria-hidden="true"></span>
            <div class="topbar__socials">
              {% for social in psm_site_socials %}
                <a href="{{ social.url }}" aria-label="{{ social.label }}" target="_blank" rel="noopener noreferrer">
                  <i class="{{ social.icon }}" aria-hidden="true"></i>
                </a>
              {% endfor %}
            </div>
          {% endif %}
        </div>
      </div>
    </div>
  </div>

  {# ── Sticky header: logo · search · CTA · burger + dark navbar ── #}
  <header class="site-header" role="banner" data-nav-open="false" data-site-header>

    <div class="site-header__main">
      <div class="site-section">
        <div class="hbar">
          <div class="hbar__logo">
            {{ page.header }}
          </div>

          {% if psm_site_search.action %}
            <form class="header-search"
                  role="search"
                  method="get"
                  action="{{ psm_site_search.action }}"
                  data-header-search
                  data-suggest-url="{{ psm_site_search.suggest_url }}">
              <div class="header-search__box">
                <input class="header-search__input"
                       type="text"
                       name="search"
                       placeholder="{{ 'Search products, part numbers…'|t }}"
                       aria-label="{{ 'Search products'|t }}"
                       autocomplete="off"
                       data-search-input>
                <button class="header-search__btn" type="submit" aria-label="{{ 'Search'|t }}">
                  <i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i>
                  <span class="header-search__btn-label">{{ 'Search'|t }}</span>
                </button>
              </div>
              <div class="header-search__sugg" data-search-suggestions hidden
                   data-label-popular="{{ 'Popular searches'|t }}"
                   data-label-matches="{{ 'Matches'|t }}"
                   data-label-empty="{{ 'No quick matches — press Enter to search the full catalogue.'|t }}"
                   data-label-browse="{{ 'Browse full catalogue'|t }}"></div>
            </form>
          {% endif %}

          <div class="hbar__actions">
            {% if psm_site_quote %}
              <a class="btn btn--amber hbar__cta{{ psm_site_quote.modal ? ' use-ajax' }}"
                 href="{{ psm_site_quote.url }}"
                 {%- if psm_site_quote.modal %} data-dialog-type="modal" data-dialog-options='{"width":720,"classes":{"ui-dialog":"quote-modal"}}'{% endif %}>{{ 'Request a quote'|t }}</a>
            {% endif %}
            <button class="nav-toggle" type="button"
                    aria-label="{{ 'Open navigation menu'|t }}"
                    aria-expanded="false"
                    aria-controls="nav-drawer"
                    data-nav-toggle>
              <span></span><span></span><span></span>
            </button>
          </div>
        </div>
      </div>
    </div>

    <nav class="navbar" aria-label="{{ 'Primary navigation'|t }}">
      <div class="site-section">
        <div class="navbar__inner">
          <div class="navbar__menu">
            {{ page.primary_menu }}
          </div>
          {% if psm_site_contact.phone %}
            <a class="navbar__phone" href="{{ psm_site_contact.phone_href }}">
              <i class="fa-solid fa-phone" aria-hidden="true"></i>
              <span>{{ '24/7 line'|t }} · {{ psm_site_contact.phone }}</span>
            </a>
          {% endif %}
        </div>
      </div>
    </nav>

    {# ── Mobile drawer ── #}
    <div class="nav-backdrop" data-nav-backdrop aria-hidden="true"></div>

    <aside class="nav-drawer" id="nav-drawer" aria-hidden="true" aria-label="{{ 'Site navigation'|t }}">
      <div class="nav-drawer__header">
        <span class="nav-drawer__title">{{ 'Menu'|t }}</span>
        <button class="nav-drawer__close" type="button" aria-label="{{ 'Close navigation menu'|t }}" data-nav-close>
          <i class="fa-solid fa-xmark" aria-hidden="true"></i>
        </button>
      </div>

      <div class="nav-drawer__menu">
        {{ page.primary_menu }}
      </div>

      {% if psm_site_quote %}
        <div class="nav-drawer__cta">
          <a class="btn btn--amber btn--block{{ psm_site_quote.modal ? ' use-ajax' }}"
             href="{{ psm_site_quote.url }}"
             {%- if psm_site_quote.modal %} data-dialog-type="modal" data-dialog-options='{"width":720,"classes":{"ui-dialog":"quote-modal"}}'{% endif %}>{{ 'Request a quote'|t }}</a>
        </div>
      {% endif %}

      {% if page.secondary_menu %}
        <div class="nav-drawer__section">
          <h4 class="nav-drawer__label">{{ 'Language'|t }}</h4>
          {{ page.secondary_menu }}
        </div>
      {% endif %}

      <div class="nav-drawer__section">
        <h4 class="nav-drawer__label">{{ 'Contact'|t }}</h4>
        <ul class="nav-drawer__contact">
          {% if psm_site_contact.location %}
            <li>
              <i class="fa-solid fa-location-dot" aria-hidden="true"></i>
              <span>{{ psm_site_contact.location }}</span>
            </li>
          {% endif %}
          {% if psm_site_contact.phone %}
            <li>
              <i class="fa-solid fa-phone" aria-hidden="true"></i>
              <a href="{{ psm_site_contact.phone_href }}">{{ psm_site_contact.phone }}</a>
            </li>
          {% endif %}
          {% if psm_site_contact.email %}
            <li>
              <i class="fa-solid fa-envelope" aria-hidden="true"></i>
              <a href="mailto:{{ psm_site_contact.email }}">{{ psm_site_contact.email }}</a>
            </li>
          {% endif %}
        </ul>
        {% if psm_site_socials %}
          <div class="nav-drawer__socials">
            {% for social in psm_site_socials %}
              <a href="{{ social.url }}" aria-label="{{ social.label }}" target="_blank" rel="noopener noreferrer">
                <i class="{{ social.icon }}" aria-hidden="true"></i>
              </a>
            {% endfor %}
          </div>
        {% endif %}
      </div>
    </aside>
  </header>

  {% if page.breadcrumb %}
    <div class="site-section">
      {{ page.breadcrumb }}
      {{ page.help }}
    </div>
  {% endif %}

  <main class="content-shell" role="main">
    <a id="main-content" tabindex="-1"></a>

    {% if messages %}
      <div class="site-section pt-6">
        {{ messages }}
      </div>
    {% endif %}

    <div>
      {{ page.content }}
    </div>
  </main>

  {# ── Footer ── #}
  <footer class="footer" role="contentinfo">
    <div class="site-section">
      <div class="footer__grid">

        <div class="footer__brand">
          <a class="footer__logo" href="{{ path('<front>') }}" rel="home">
            {% if psm_site_footer.logo %}
              <img src="{{ psm_site_footer.logo }}" alt="{{ 'Home'|t }}" loading="lazy">
            {% endif %}
            <span class="footer__logo-text">
              <span class="footer__wordmark">{{ psm_site_footer.site_name }}</span>
              {% if psm_site_footer.slogan %}
                <span class="footer__slogan">{{ psm_site_footer.slogan }}</span>
              {% endif %}
            </span>
          </a>
          {% if psm_site_footer.text %}
            <p class="footer__text">{{ psm_site_footer.text }}</p>
          {% endif %}
          {% if psm_site_socials %}
            <div class="footer__socials">
              {% for social in psm_site_socials %}
                <a href="{{ social.url }}" aria-label="{{ social.label }}" target="_blank" rel="noopener noreferrer">
                  <i class="{{ social.icon }}" aria-hidden="true"></i>
                </a>
              {% endfor %}
            </div>
          {% endif %}
        </div>

        {% if psm_site_footer.menu %}
          <nav class="footer__col" aria-label="{{ 'Footer navigation'|t }}">
            <h4 class="footer__heading">{{ 'Menu'|t }}</h4>
            <ul class="footer__links">
              {% for link in psm_site_footer.menu %}
                <li><a href="{{ link.url }}">{{ link.title }}</a></li>
              {% endfor %}
            </ul>
          </nav>
        {% endif %}

        {% if page.footer %}
          <div class="footer__col footer__col--blocks">
            {{ page.footer }}
          </div>
        {% endif %}

        <div class="footer__col footer__col--contact">
          <h4 class="footer__heading">{{ 'Contact'|t }}</h4>
          <ul class="footer__contact">
            {% if psm_site_contact.location %}
              <li>
                <i class="fa-solid fa-location-dot" aria-hidden="true"></i>
                <span>{{ psm_site_contact.location }}</span>
              </li>
            {% endif %}
            {% if psm_site_contact.phone %}
              <li>
                <i class="fa-solid fa-phone" aria-hidden="true"></i>
                <a href="{{ psm_site_contact.phone_href }}">{{ psm_site_contact.phone }}</a>
              </li>
            {% endif %}
            {% if psm_site_contact.email %}
              <li>
                <i class="fa-solid fa-envelope" aria-hidden="true"></i>
                <a href="mailto:{{ psm_site_contact.email }}">{{ psm_site_contact.email }}</a>
              </li>
            {% endif %}
          </ul>
          {% if psm_site_quote %}
            <a class="btn btn--amber footer__quote{{ psm_site_quote.modal ? ' use-ajax' }}"
               href="{{ psm_site_quote.url }}"
               {%- if psm_site_quote.modal %} data-dialog-type="modal" data-dialog-options='{"width":720,"classes":{"ui-dialog":"quote-modal"}}'{% endif %}>{{ 'Request a quote'|t }}</a>
          {% endif %}
        </div>

      </div>
    </div>

    <div class="footer__bar">
      <div class="site-section">
        <div class="footer__bar-inner">
          <p>© {{ psm_site_footer.year }} {{ psm_site_footer.site_name }}. {{ 'All rights reserved.'|t }}</p>
          {% if psm_site_footer.legal %}
            <div class="footer__legal">
              {% for link in psm_site_footer.legal %}
                <a href="{{ link.url }}">{{ link.title }}</a>
              {% endfor %}
            </div>
          {% endif %}
        </div>
      </div>
    </div>
  </footer>
</div>

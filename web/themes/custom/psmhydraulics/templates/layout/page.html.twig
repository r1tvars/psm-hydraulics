{#
/**
 * @file
 * Theme override to display a single page.
 */
#}
<div class="site-shell">
  {{ attach_library('psmhydraulics/nav') }}
  <header class="site-header" role="banner" data-nav-open="false">

    {# Utility bar: contacts + socials — hidden on mobile, visible md+ #}
    <div class="site-header__topbar">
      <div class="site-section">
        <div class="flex items-center justify-between py-2.5">

          <div class="flex items-center gap-5">
            {% if psm_site_contact.phone %}
              <a class="header-top-item hover:text-white" href="tel:{{ psm_site_contact.phone|replace({' ': '', '(': '', ')': '', '-': ''}) }}">
                <i class="fa-solid fa-phone text-brand" aria-hidden="true"></i>
                <span>{{ psm_site_contact.phone }}</span>
              </a>
            {% endif %}
            {% if psm_site_contact.email %}
              <a class="header-top-item hover:text-white" href="mailto:{{ psm_site_contact.email }}">
                <i class="fa-solid fa-envelope text-brand" aria-hidden="true"></i>
                <span>{{ psm_site_contact.email }}</span>
              </a>
            {% endif %}
            {% if psm_site_contact.location %}
              <div class="header-top-item">
                <i class="fa-solid fa-location-dot text-brand" aria-hidden="true"></i>
                <span>{{ psm_site_contact.location }}</span>
              </div>
            {% endif %}
          </div>

          <div class="flex items-center">
            <a class="header-top-social" href="#" aria-label="Facebook">
              <i class="fa-brands fa-facebook-f" aria-hidden="true"></i>
            </a>
            <a class="header-top-social" href="#" aria-label="Twitter">
              <i class="fa-brands fa-x-twitter" aria-hidden="true"></i>
            </a>
            <a class="header-top-social" href="#" aria-label="LinkedIn">
              <i class="fa-brands fa-linkedin-in" aria-hidden="true"></i>
            </a>
            <a class="header-top-social" href="#" aria-label="Instagram">
              <i class="fa-brands fa-instagram" aria-hidden="true"></i>
            </a>
          </div>

        </div>
      </div>
    </div>

    {# Main nav bar — sticky #}
    <div class="site-header__bar">
      <div class="site-section">
        <div class="flex items-center justify-between gap-4 py-4 xl:py-0">

          {# Logo #}
          <div class="flex-shrink-0">
            {{ page.header }}
          </div>

          {# Primary navigation — desktop only #}
          <nav class="hidden xl:flex xl:flex-1 xl:items-center xl:justify-end" aria-label="Primary navigation" id="main-navigation">
            {{ page.primary_menu }}
          </nav>

          {# Language switcher (desktop) + hamburger (mobile/tablet) #}
          <div class="flex items-center gap-3">
            {% if page.secondary_menu %}
              <div class="hidden xl:block">
                {{ page.secondary_menu }}
              </div>
            {% endif %}

            <button class="nav-toggle" type="button"
                    aria-label="Open navigation menu"
                    aria-expanded="false"
                    aria-controls="nav-drawer"
                    data-nav-toggle>
              <i class="fa-solid fa-bars" aria-hidden="true"></i>
            </button>
          </div>

        </div>
      </div>
    </div>

    {# Drawer backdrop #}
    <div class="nav-backdrop" data-nav-backdrop aria-hidden="true"></div>

    {# Mobile/tablet slide-in drawer #}
    <div class="nav-drawer" id="nav-drawer" aria-hidden="true" aria-label="Site navigation">

      <div class="nav-drawer__header">
        <span class="nav-drawer__title">{{ 'Menu'|t }}</span>
        <button class="nav-drawer__close" type="button" aria-label="{{ 'Close navigation menu'|t }}" data-nav-close>
          <i class="fa-solid fa-xmark" aria-hidden="true"></i>
        </button>
      </div>

      <div class="nav-drawer__body">
        {{ page.primary_menu }}
      </div>

      {% if page.secondary_menu %}
        <div class="nav-drawer__lang-section">
          {{ page.secondary_menu }}
        </div>
      {% endif %}

      <div class="nav-drawer__contact-section">
        {% if psm_site_contact.phone %}
          <a class="nav-drawer__contact-item" href="tel:{{ psm_site_contact.phone|replace({' ': '', '(': '', ')': '', '-': ''}) }}">
            <i class="fa-solid fa-phone text-brand" aria-hidden="true"></i>
            <span>{{ psm_site_contact.phone }}</span>
          </a>
        {% endif %}
        {% if psm_site_contact.email %}
          <a class="nav-drawer__contact-item" href="mailto:{{ psm_site_contact.email }}">
            <i class="fa-solid fa-envelope text-brand" aria-hidden="true"></i>
            <span>{{ psm_site_contact.email }}</span>
          </a>
        {% endif %}
        {% if psm_site_contact.location %}
          <div class="nav-drawer__contact-item">
            <i class="fa-solid fa-location-dot text-brand" aria-hidden="true"></i>
            <span>{{ psm_site_contact.location }}</span>
          </div>
        {% endif %}
      </div>

      <div class="nav-drawer__socials">
        <a class="nav-drawer__social-link" href="#" aria-label="Facebook">
          <i class="fa-brands fa-facebook-f" aria-hidden="true"></i>
        </a>
        <a class="nav-drawer__social-link" href="#" aria-label="Twitter">
          <i class="fa-brands fa-x-twitter" aria-hidden="true"></i>
        </a>
        <a class="nav-drawer__social-link" href="#" aria-label="LinkedIn">
          <i class="fa-brands fa-linkedin-in" aria-hidden="true"></i>
        </a>
        <a class="nav-drawer__social-link" href="#" aria-label="Instagram">
          <i class="fa-brands fa-instagram" aria-hidden="true"></i>
        </a>
      </div>

    </div>

  </header>

  {% if page.breadcrumb %}
    <div class="site-section">
      {{ page.breadcrumb }}
      {{ page.help }}
    </div>
  {% endif %}

  <main class="content-shell" role="main">
    <a id="main-content" tabindex="-1"></a>

    {% if messages %}
      <div class="site-section pt-6">
        {{ messages }}
      </div>
    {% endif %}

    <div>
      {{ page.content }}
    </div>
  </main>

  {% if page.footer %}
    <footer class="mt-12 border-t border-steel-200 bg-white py-10" role="contentinfo">
      <div class="site-section">
        {{ page.footer }}
      </div>
    </footer>
  {% endif %}
</div>

{#
/**
 * @file
 * Main menu: 3 levels.
 *
 * Desktop (.navbar): level 0 inline, levels 1–2 inside a full-width
 * mega panel (columns with heading + links), opened on hover/focus.
 * Drawer (.nav-drawer): the same markup becomes nested accordions,
 * toggled by the [data-menu-toggle] buttons (see nav.js).
 */
#}
{% if items %}
  <ul class="nav-menu">
    {% for item in items %}
      {% set has_children = item.below is not empty %}
      {% set link_classes = ['nav-menu__link'] %}
      {% if item.in_active_trail %}
        {% set link_classes = link_classes|merge(['is-active']) %}
      {% endif %}

      <li class="nav-menu__item{{ has_children ? ' nav-menu__item--mega' }}">
        <div class="nav-menu__row">
          {{ link(item.title, item.url, {'class': link_classes}) }}
          {% if has_children %}
            <span class="nav-menu__chev" aria-hidden="true">
              <i class="fa-solid fa-angle-down"></i>
            </span>
            <button class="nav-menu__toggle" type="button"
                    aria-expanded="false"
                    aria-label="{{ 'Toggle @title submenu'|t({'@title': item.title}) }}"
                    data-menu-toggle>
              <i class="fa-solid fa-angle-down" aria-hidden="true"></i>
            </button>
          {% endif %}
        </div>

        {% if has_children %}
          <div class="mega{{ item.mega_foot ? ' mega--catalogue' }}" data-menu-panel>
            <div class="mega__frame">
              <div class="mega__inner">
                <div class="mega__cols">
                  {% for child in item.below %}
                    {% set child_has_children = child.below is not empty %}
                    {% set child_classes = ['mega__heading'] %}
                    {% if child.in_active_trail %}
                      {% set child_classes = child_classes|merge(['is-active']) %}
                    {% endif %}

                    <div class="mega__col">
                      <div class="mega__col-head">
                        <span class="mega__code" aria-hidden="true">{{ '%02d'|format(loop.index) }}</span>
                        {{ link(child.title, child.url, {'class': child_classes}) }}
                        {% if child_has_children %}
                          <button class="nav-menu__toggle nav-menu__toggle--sub" type="button"
                                  aria-expanded="false"
                                  aria-label="{{ 'Toggle @title submenu'|t({'@title': child.title}) }}"
                                  data-menu-toggle>
                            <i class="fa-solid fa-angle-down" aria-hidden="true"></i>
                          </button>
                        {% endif %}
                      </div>

                      {% if child_has_children %}
                        <div class="mega__sub" data-menu-panel>
                          <ul class="mega__list">
                            {% for sub in child.below %}
                              {% set sub_classes = ['mega__link'] %}
                              {% if sub.in_active_trail %}
                                {% set sub_classes = sub_classes|merge(['is-active']) %}
                              {% endif %}
                              <li>
                                {{ link(sub.title, sub.url, {'class': sub_classes}) }}
                              </li>
                            {% endfor %}
                          </ul>
                        </div>
                      {% endif %}
                    </div>
                  {% endfor %}
                </div>

                {# Only the catalogue panel sets this (see
                   psmhydraulics_preprocess_menu). #}
                {% if item.mega_foot %}
                  <div class="mega__foot">
                    <span class="mega__note">{{ item.mega_foot.note }}</span>
                    <a class="mega__cta" href="{{ item.mega_foot.url }}">
                      {{ item.mega_foot.label }}
                      <i class="fa-solid fa-arrow-right" aria-hidden="true"></i>
                    </a>
                  </div>
                {% endif %}
              </div>
            </div>
          </div>
        {% endif %}
      </li>
    {% endfor %}
  </ul>
{% endif %}

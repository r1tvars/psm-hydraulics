{#
/**
 * @file
 * Product category landing page: ink page-head band with the category trail,
 * child-category cards, then the products of this category and everything
 * below it (the view argument matches the whole subtree).
 *
 * category_view comes from psmhydraulics_preprocess_views_view().
 */
#}
{{ attach_library('psmhydraulics/products') }}

{% set cv = category_view %}

<section class="products-head{{ cv.bg_url ? ' products-head--image' }}">
  {% if cv.bg_url %}
    <div class="products-head__bg" style="background-image: url('{{ cv.bg_url }}')" aria-hidden="true"></div>
  {% endif %}
  <div class="site-section products-head__in">
    <nav class="products-head__crumbs" aria-label="{{ 'Breadcrumb'|t }}">
      {% for crumb in cv.crumbs %}
        <a href="{{ crumb.url }}">{{ crumb.label }}</a>
        <span class="products-head__crumb-sep" aria-hidden="true">/</span>
      {% endfor %}
      <span aria-current="page">{{ cv.title }}</span>
    </nav>
    <div class="products-head__row">
      <div>
        <span class="eyebrow">{{ cv.eyebrow }}</span>
        <h1 class="products-head__title">{{ cv.title }}</h1>
        {% if cv.description %}
          <div class="products-head__sub">{{ cv.description|raw }}</div>
        {% endif %}
      </div>
      <div class="products-head__counter">
        <b>{{ '%03d'|format(cv.total) }}</b>
        <span>{{ 'Items on record'|t }}</span>
      </div>
    </div>
  </div>
</section>

{% if cv.children %}
  <section class="site-section products-browse" aria-labelledby="category-children-title">
    <div class="products-browse__head">
      <span class="eyebrow">{{ 'Browse'|t }}</span>
      <h2 class="products-browse__title" id="category-children-title">{{ 'Subcategories'|t }}</h2>
    </div>
    <div class="products-browse__grid">
      {% for card in cv.children %}
        {% include '@psmhydraulics/includes/category-card.html.twig' with { card: card } only %}
      {% endfor %}
    </div>
  </section>
{% endif %}

<section class="site-section category-products">
  <div class="category-products__head">
    <div>
      <span class="eyebrow eyebrow--dark">{{ 'Catalogue'|t }}</span>
      <h2 class="products-browse__title">{{ 'Products'|t }}</h2>
    </div>
    <a class="btn btn--outline" href="{{ cv.refine_url }}">
      {{ 'Refine in full catalogue'|t }} <i class="fa-solid fa-arrow-right" aria-hidden="true"></i>
    </a>
  </div>

  {% if rows %}
    <div class="products-grid">
      {{ rows }}
    </div>
  {% else %}
    <div class="products-empty">
      <i class="fa-solid fa-magnifying-glass-minus" aria-hidden="true"></i>
      <h3>{{ 'Nothing listed here yet'|t }}</h3>
      <p>{{ 'This category has no published products at the moment — tell us what you need and we’ll source it.'|t }}</p>
      <a class="btn btn--ink" href="{{ cv.products_url }}">{{ 'Browse all products'|t }}</a>
    </div>
  {% endif %}

  {% if pager %}
    <div class="products-pager">{{ pager }}</div>
  {% endif %}
</section>

{% include '@psmhydraulics/includes/quote-cta.html.twig' with { quote: cv.quote } only %}

<article{{ attributes.addClass('carousel-slide') }}>
  {% if carousel_video %}
    <div class="carousel-slide__media">
      <video data-carousel-video muted playsinline preload="auto" aria-hidden="true" tabindex="-1">
        <source src="{{ carousel_video.url }}" type="{{ carousel_video.type }}">
      </video>
    </div>
  {% elseif not paragraph.field_image.isEmpty() %}
    <div class="carousel-slide__media">
      {{ content.field_image }}
    </div>
  {% endif %}

  <div class="carousel-slide__overlay" aria-hidden="true"></div>
  <div class="carousel-slide__pattern" aria-hidden="true"></div>
  <div class="carousel-slide__glow" aria-hidden="true"></div>

  <div class="carousel-slide__content">
    <div class="carousel-slide__text">
      {% if not paragraph.field_eyebrow.isEmpty() %}
        <span class="eyebrow carousel-slide__eyebrow">
          {{ content.field_eyebrow }}
        </span>
      {% endif %}

      {% if not paragraph.field_heading.isEmpty() %}
        <h2 class="carousel-slide__heading">
          {{ content.field_heading }}
        </h2>
      {% endif %}

      {% if not paragraph.field_description.isEmpty() %}
        <div class="carousel-slide__description">
          {{ content.field_description }}
        </div>
      {% endif %}

      {% if not paragraph.field_link.isEmpty() %}
        <div class="carousel-slide__link" data-carousel-pause-trigger>
          {{ content.field_link }}
        </div>
      {% endif %}
    </div>
  </div>
</article>

{% extends "block.html.twig" %}

{% block content %}
  <a class="site-logo" href="{{ path('<front>') }}" rel="home">
    {% if site_logo %}
      <img class="site-logo__mark" src="{{ site_logo }}" alt="{{ 'Home'|t }}" fetchpriority="high" />
    {% else %}
      <span class="site-logo__placeholder" aria-hidden="true">L</span>
    {% endif %}

    <span class="site-logo__text">
      {% if site_name %}
        <span class="site-logo__wordmark">{{ site_name }}</span>
      {% endif %}
      {% if site_slogan %}
        <span class="site-logo__sub">{{ site_slogan }}</span>
      {% endif %}
    </span>
  </a>
{% endblock %}

{#
/**
 * @file
 * The branch itself: an <ol> so the milestones stay a list for assistive
 * technology, with the trunk fill as its first child.
 */
#}
<ol class="history__list">
  <span class="history__fill" data-hb-fill aria-hidden="true"></span>
  {%- for item in items -%}
    {{ item.content }}
  {%- endfor -%}
</ol>

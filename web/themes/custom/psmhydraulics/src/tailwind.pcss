@tailwind base;
@tailwind components;
@tailwind utilities;

@layer base {
  html {
    @apply scroll-smooth;
    -webkit-text-size-adjust: 100%;
  }

  body {
    @apply bg-white font-sans text-ink antialiased;
  }

  h1,
  h2,
  h3,
  h4 {
    @apply font-display font-bold uppercase;
    line-height: 1.05;
    letter-spacing: 0.005em;
  }

  a {
    @apply transition-colors duration-200;
  }

  input {
    @apply border border-steel-300;
  }

  :focus-visible {
    @apply rounded-sm outline outline-2 outline-offset-2 outline-amber;
  }
}

@layer components {
  .site-shell {
    @apply min-h-screen overflow-x-clip bg-white;
  }

  .site-section {
    @apply mx-auto max-w-shell px-5 sm:px-6 lg:px-8;
  }

  /* ── Shared: eyebrow ─────────────────────────────── */

  .eyebrow {
    @apply inline-flex items-center gap-2.5 font-mono text-xs font-medium uppercase tracking-[0.22em] text-amber;
  }

  .eyebrow::before {
    @apply inline-block h-0.5 w-[22px] flex-shrink-0 bg-amber;
    content: '';
  }

  .eyebrow--dark {
    @apply text-amber-deep;
  }

  .eyebrow--dark::before {
    @apply bg-amber-deep;
  }

  .eyebrow .field,
  .eyebrow .field__item {
    display: contents;
  }

  /* ── Shared: buttons ─────────────────────────────── */

  .btn {
    @apply inline-flex items-center justify-center gap-3 whitespace-nowrap rounded-brand px-6 py-3.5 font-mono text-[13px] font-semibold uppercase tracking-[0.14em] transition-all duration-200;
  }

  .btn--amber {
    @apply bg-amber text-ink hover:bg-amber-deep;
  }

  .btn--ghost {
    @apply border border-line-dark-2 text-white hover:border-amber hover:text-amber;
  }

  .btn--ink {
    @apply bg-ink text-white hover:bg-ink-deep;
  }

  .btn--block {
    @apply w-full;
  }

  /* ── Top utility bar (desktop only) ──────────────── */

  .topbar {
    @apply hidden border-b border-line-dark bg-ink text-[13px] text-steelgray lg:block;
  }

  .topbar__inner {
    @apply flex h-11 items-center justify-between gap-5;
  }

  .topbar__info {
    @apply flex flex-wrap items-center gap-x-6 gap-y-1;
  }

  .topbar__item {
    @apply inline-flex items-center gap-2 text-steelgray;
  }

  .topbar__item i {
    @apply text-xs text-amber;
  }

  a.topbar__item:hover {
    @apply text-white;
  }

  .topbar__right {
    @apply flex items-center gap-4;
  }

  .topbar__sep {
    @apply h-5 w-px bg-line-dark;
  }

  .topbar__socials {
    @apply flex gap-1.5;
  }

  .topbar__socials a {
    @apply inline-flex h-[30px] w-[30px] items-center justify-center border border-line-dark text-xs text-steelgray;
  }

  .topbar__socials a:hover {
    @apply border-amber text-white;
  }

  /* ── Sticky header: logo · search · CTA ──────────── */

  .site-header {
    @apply sticky top-0 z-50 bg-white transition-shadow duration-300;
  }

  .site-header.is-scrolled {
    box-shadow: 0 8px 30px rgba(12, 26, 41, 0.12);
  }

  .hbar {
    @apply flex flex-wrap items-center gap-x-4 gap-y-3 py-3 lg:flex-nowrap lg:gap-6 lg:py-0;
  }

  @media (min-width: 1024px) {
    .hbar {
      height: 82px;
      transition: height 0.3s ease;
    }

    .site-header.is-scrolled .hbar {
      height: 70px;
    }
  }

  .hbar__logo {
    @apply order-1 flex-shrink-0;
  }

  .hbar__actions {
    @apply order-2 ml-auto flex items-center gap-3 lg:order-3 lg:ml-0;
  }

  .hbar__cta {
    @apply hidden lg:inline-flex;
  }

  /* ── Site logo ───────────────────────────────────── */

  .site-logo {
    @apply flex items-center gap-3;
  }

  .site-logo__mark {
    @apply h-10 w-auto;
  }

  .site-logo__placeholder {
    @apply flex h-10 w-10 items-center justify-center rounded-brand bg-ink font-display text-lg font-bold text-amber;
  }

  .site-logo__text {
    @apply flex flex-col;
  }

  .site-logo__wordmark {
    @apply font-display text-[23px] font-bold uppercase leading-none tracking-[0.04em] text-ink;
  }

  .site-logo__sub {
    @apply mt-1 hidden font-mono text-[9.5px] uppercase tracking-[0.34em] text-slate-soft sm:block;
  }

  /* ── Header search ───────────────────────────────── */

  .header-search {
    @apply relative order-3 w-full lg:order-2 lg:mx-auto lg:w-auto lg:max-w-[580px] lg:flex-1;
  }

  .header-search__box {
    @apply flex items-stretch overflow-hidden rounded-brand border border-paper-line bg-paper transition-all duration-200;
  }

  .header-search__box:focus-within {
    @apply border-amber;
    box-shadow: 0 0 0 3px rgba(247, 162, 27, 0.16);
  }

  .header-search__input {
    @apply min-w-0 flex-1 border-0 bg-transparent px-3.5 py-3 text-[15px] text-ink outline-none placeholder:text-slate-soft;
  }

  .header-search__btn {
    @apply flex items-center gap-2 bg-amber px-4 font-mono text-xs font-semibold uppercase tracking-[0.12em] text-ink transition-colors duration-200 hover:bg-amber-deep;
  }

  .header-search__btn-label {
    @apply hidden sm:inline;
  }

  .header-search__sugg {
    @apply absolute inset-x-0 top-[calc(100%+8px)] z-40 max-h-[360px] overflow-auto rounded-brand border border-paper-line border-t-2 border-t-amber bg-white p-2 shadow-panel;
  }

  .header-search__sugg-label {
    @apply px-2.5 pb-1.5 pt-2 font-mono text-[11px] uppercase tracking-[0.16em] text-slate-soft;
  }

  .header-search__sugg-item {
    @apply flex items-center gap-3 rounded-sm px-2.5 py-2.5 text-sm text-ink;
  }

  .header-search__sugg-item:hover,
  .header-search__sugg-item.is-highlighted {
    @apply bg-paper;
  }

  .header-search__sugg-item i {
    @apply text-xs text-slate-soft;
  }

  .header-search__sugg-title {
    @apply truncate;
  }

  .header-search__sugg-cat {
    @apply ml-auto flex-shrink-0 font-mono text-[11px] text-slate-soft;
  }

  .header-search__sugg-empty {
    @apply px-2.5 py-4 text-sm text-slate-soft;
  }

  .header-search__sugg-foot {
    @apply mt-1.5 border-t border-paper-line pt-1.5;
  }

  .header-search__sugg-foot a {
    @apply flex items-center justify-between px-2.5 py-2.5 font-mono text-xs uppercase tracking-[0.1em] text-amber-deep hover:text-amber;
  }

  /* ── Hamburger ───────────────────────────────────── */

  .nav-toggle {
    @apply flex h-11 w-11 flex-col items-center justify-center gap-[5px] rounded-brand border border-paper-line lg:hidden;
  }

  .nav-toggle span {
    @apply block h-0.5 w-5 bg-ink transition-all duration-200;
  }

  .site-header[data-nav-open='true'] .nav-toggle span:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }

  .site-header[data-nav-open='true'] .nav-toggle span:nth-child(2) {
    opacity: 0;
  }

  .site-header[data-nav-open='true'] .nav-toggle span:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }

  /* ── Dark primary navbar (desktop) ───────────────── */

  .navbar {
    @apply relative hidden bg-ink lg:block;
  }

  .navbar__inner {
    @apply flex h-[52px] items-center justify-between gap-4;
  }

  .navbar__menu {
    @apply flex min-w-0 items-center;
  }

  .navbar__phone {
    @apply hidden flex-shrink-0 items-center gap-2 font-mono text-[12.5px] tracking-[0.05em] text-steelgray hover:text-white xl:inline-flex;
  }

  .navbar__phone i {
    @apply text-amber;
  }

  .navbar .nav-menu {
    @apply flex items-center;
  }

  .navbar .nav-menu__row {
    @apply flex h-[52px] items-center;
  }

  .navbar .nav-menu__link {
    @apply relative flex h-full items-center px-4 font-display text-[15px] font-medium uppercase tracking-[0.06em] text-[#E7ECF1];
  }

  .navbar .nav-menu__link::after {
    @apply absolute inset-x-4 bottom-0 h-[3px] origin-left scale-x-0 bg-amber transition-transform duration-200 ease-blueprint;
    content: '';
  }

  .navbar .nav-menu__item:hover .nav-menu__link,
  .navbar .nav-menu__item:focus-within .nav-menu__link,
  .navbar .nav-menu__link.is-active {
    @apply text-amber;
  }

  .navbar .nav-menu__item:hover .nav-menu__link::after,
  .navbar .nav-menu__item:focus-within .nav-menu__link::after,
  .navbar .nav-menu__link.is-active::after {
    @apply scale-x-100;
  }

  .navbar .nav-menu__chev {
    @apply -ml-2.5 mr-2 text-[10px] text-steelgray transition-transform duration-200;
  }

  .navbar .nav-menu__item:hover .nav-menu__chev {
    @apply rotate-180 text-amber;
  }

  .navbar .nav-menu__toggle {
    @apply hidden;
  }

  /* Full-width mega panel (levels 2–3) */

  .navbar .mega {
    @apply invisible absolute inset-x-0 top-full z-40 border-t border-line-dark bg-ink opacity-0 shadow-mega;
    border-bottom: 2px solid theme('colors.amber.DEFAULT');
    transform: translateY(8px);
    transition: opacity 0.22s theme('transitionTimingFunction.blueprint'),
      transform 0.22s theme('transitionTimingFunction.blueprint'),
      visibility 0.22s;
  }

  .navbar .nav-menu__item--mega:hover > .mega,
  .navbar .nav-menu__item--mega:focus-within > .mega {
    @apply visible opacity-100;
    transform: translateY(0);
  }

  .navbar .mega__inner {
    @apply mx-auto max-w-shell px-5 py-8 sm:px-6 lg:px-8;
  }

  .navbar .mega__cols {
    @apply grid gap-7;
    grid-template-columns: repeat(auto-fit, minmax(200px, 232px));
  }

  .navbar .mega__col-head {
    @apply mb-2 flex items-center gap-2.5 border-b border-line-dark pb-3;
  }

  .navbar .mega__code {
    @apply font-mono text-[11px] text-amber;
  }

  .navbar .mega__heading {
    @apply font-display text-[15px] uppercase tracking-[0.05em] text-white hover:text-amber;
  }

  .navbar .mega__link {
    @apply block py-1.5 text-sm text-[#9FACB8] transition-all duration-150 hover:pl-1.5 hover:text-amber;
  }

  .navbar .mega__link.is-active {
    @apply text-amber;
  }

  /* ── Mobile drawer ───────────────────────────────── */

  .nav-backdrop {
    @apply fixed inset-0 z-[60] bg-ink-deep/60;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.3s ease, visibility 0.3s ease;
  }

  .site-header[data-nav-open='true'] .nav-backdrop {
    opacity: 1;
    visibility: visible;
  }

  .nav-drawer {
    @apply fixed inset-y-0 right-0 z-[70] flex w-[min(380px,90vw)] flex-col overflow-y-auto border-l-2 border-amber bg-ink;
    transform: translateX(100%);
    visibility: hidden;
    transition: transform 0.32s theme('transitionTimingFunction.blueprint'), visibility 0.32s;
  }

  .site-header[data-nav-open='true'] .nav-drawer {
    transform: translateX(0);
    visibility: visible;
  }

  .nav-drawer__header {
    @apply flex items-center justify-between border-b border-line-dark px-5 py-4;
  }

  .nav-drawer__title {
    @apply font-display text-lg font-bold uppercase tracking-[0.12em] text-white;
  }

  .nav-drawer__close {
    @apply flex h-10 w-10 items-center justify-center rounded-brand border border-line-dark text-lg text-white hover:border-amber hover:text-amber;
  }

  .nav-drawer__menu {
    @apply px-5 py-1;
  }

  .nav-drawer__cta {
    @apply px-5 pt-5;
  }

  .nav-drawer__section {
    @apply mt-5 border-t border-line-dark px-5 py-5;
  }

  .nav-drawer__section + .nav-drawer__section {
    @apply mt-0;
  }

  .nav-drawer__label {
    @apply mb-3.5 font-mono text-[11px] font-medium uppercase tracking-[0.2em] text-steelgray;
  }

  .nav-drawer__contact li {
    @apply mb-3.5 flex items-start gap-3 text-sm text-[#9FACB8];
  }

  .nav-drawer__contact i {
    @apply mt-1 text-xs text-amber;
  }

  .nav-drawer__contact a {
    @apply text-[#9FACB8] hover:text-white;
  }

  .nav-drawer__socials {
    @apply mt-2 flex gap-2;
  }

  .nav-drawer__socials a {
    @apply flex h-9 w-9 items-center justify-center rounded-brand border border-line-dark text-sm text-[#C9D4DE] hover:border-amber hover:text-amber;
  }

  /* Drawer menu: nested accordions (same markup as the mega menu) */

  .nav-drawer .nav-menu {
    @apply flex flex-col;
  }

  .nav-drawer .nav-menu__item {
    @apply border-b border-line-dark;
  }

  .nav-drawer .nav-menu__row {
    @apply flex items-center justify-between;
  }

  .nav-drawer .nav-menu__link {
    @apply flex-1 py-4 font-display text-lg font-medium uppercase tracking-[0.05em] text-white;
  }

  .nav-drawer .nav-menu__link.is-active {
    @apply text-amber;
  }

  .nav-drawer .nav-menu__chev {
    @apply hidden;
  }

  .nav-drawer .nav-menu__toggle {
    @apply flex h-11 w-11 items-center justify-center text-amber;
  }

  .nav-drawer .nav-menu__toggle i {
    @apply transition-transform duration-200;
  }

  .nav-drawer .nav-menu__toggle[aria-expanded='true'] i {
    @apply rotate-180;
  }

  .nav-drawer [data-menu-panel] {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.3s theme('transitionTimingFunction.blueprint');
  }

  .nav-drawer [data-menu-panel] > * {
    overflow: hidden;
    min-height: 0;
  }

  .nav-drawer [data-menu-panel].is-open {
    grid-template-rows: 1fr;
  }

  .nav-drawer .mega__inner {
    @apply pb-2;
  }

  .nav-drawer .mega__cols {
    @apply flex flex-col;
  }

  .nav-drawer .mega__col + .mega__col {
    @apply border-t border-line-dark;
  }

  .nav-drawer .mega__col-head {
    @apply flex items-center justify-between;
  }

  .nav-drawer .mega__code {
    @apply hidden;
  }

  .nav-drawer .mega__heading {
    @apply flex-1 py-3 pl-3.5 font-display text-[15px] uppercase tracking-[0.04em] text-[#C9D4DE];
  }

  .nav-drawer .mega__heading.is-active {
    @apply text-amber;
  }

  .nav-drawer .nav-menu__toggle--sub {
    @apply h-10 w-10;
  }

  .nav-drawer .mega__list {
    @apply pb-2;
  }

  .nav-drawer .mega__link {
    @apply flex items-center gap-2.5 py-2.5 pl-7 text-sm text-[#93A1AC] hover:text-amber;
  }

  .nav-drawer .mega__link::before {
    @apply h-1 w-1 flex-shrink-0 rounded-full bg-amber;
    content: '';
  }

  /* ── Language switcher ───────────────────────────── */

  .language-switcher {
    @apply relative;
  }

  .language-switcher__trigger {
    @apply inline-flex items-center gap-2 py-1.5 font-mono text-xs tracking-[0.08em] text-steelgray hover:text-white;
  }

  .language-switcher__flag {
    @apply inline-block h-[15px] w-[22px] overflow-hidden rounded-[1px] bg-cover bg-center leading-none;
    box-shadow: 0 0 0 1px rgba(255, 255, 255, 0.12);
  }

  .language-switcher__code {
    @apply font-mono text-xs;
  }

  .language-switcher__chevron {
    @apply text-[10px] transition-transform duration-200;
  }

  .language-switcher[data-open='true'] .language-switcher__chevron {
    @apply rotate-180;
  }

  .language-switcher__panel {
    @apply absolute right-0 top-[calc(100%+8px)] z-[60] min-w-[184px] rounded-brand border border-line-dark border-t-2 border-t-amber bg-ink p-1.5 shadow-mega;
  }

  .language-switcher__list {
    @apply space-y-0.5;
  }

  .language-switcher__item {
    @apply flex items-center gap-3 rounded-sm px-2.5 py-2.5 transition-colors duration-150 hover:bg-panel;
  }

  .language-switcher__link {
    @apply flex-1 text-left text-sm text-[#C9D4DE] hover:text-white;
  }

  .language-switcher__item.is-active .language-switcher__link {
    @apply text-amber;
  }

  .language-switcher__active {
    @apply ml-auto text-xs text-amber;
  }

  /* Drawer variant: inline pills instead of a dropdown */

  .nav-drawer .language-switcher__trigger {
    @apply hidden;
  }

  .nav-drawer .language-switcher__panel {
    @apply static block min-w-0 rounded-none border-0 bg-transparent p-0 shadow-none;
  }

  .nav-drawer .language-switcher__list {
    @apply flex flex-wrap gap-2 space-y-0;
  }

  .nav-drawer .language-switcher__item {
    @apply inline-flex gap-2 rounded-brand border border-line-dark px-3 py-2 hover:bg-transparent;
  }

  .nav-drawer .language-switcher__item.is-active {
    @apply border-amber;
  }

  .nav-drawer .language-switcher__link {
    @apply flex-none font-mono text-xs tracking-[0.06em] text-[#C9D4DE];
  }

  .nav-drawer .language-switcher__item.is-active .language-switcher__link {
    @apply text-amber;
  }

  .nav-drawer .language-switcher__active {
    @apply hidden;
  }

  /* ── Hero carousel ───────────────────────────────── */

  .carousel-block {
    @apply relative isolate overflow-hidden bg-ink;
    height: var(--carousel-height, 72svh);
    min-height: 28rem;
    --carousel-progress-duration: 8s;
  }

  .carousel-block .splide__track,
  .carousel-block .splide__list,
  .carousel-block .splide__slide {
    @apply h-full;
  }

  .carousel-slide {
    @apply relative flex h-full items-center overflow-hidden bg-ink text-white;
  }

  .carousel-slide__media,
  .carousel-slide__media > div,
  .carousel-slide__media > div > div,
  .carousel-slide__media > div > div > div,
  .carousel-slide__media .field,
  .carousel-slide__media .field__item,
  .carousel-slide__media .media,
  .carousel-slide__media .media__content {
    @apply absolute inset-0;
  }

  .carousel-slide__media img,
  .carousel-slide__media video {
    @apply h-full w-full select-none object-cover;
    -webkit-user-drag: none;
    user-select: none;
  }

  .carousel-slide__overlay {
    @apply absolute inset-0;
    background: linear-gradient(
        180deg,
        rgba(12, 26, 41, 0.25) 55%,
        rgba(12, 26, 41, 0.85) 100%
      ),
      linear-gradient(
        90deg,
        rgba(12, 26, 41, 0.92) 0%,
        rgba(12, 26, 41, 0.68) 46%,
        rgba(12, 26, 41, 0.3) 100%
      );
  }

  .carousel-slide__pattern {
    @apply pointer-events-none absolute inset-0 opacity-50;
    background-image: linear-gradient(rgba(255, 255, 255, 0.07) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.07) 1px, transparent 1px);
    background-size: 32px 32px;
    -webkit-mask-image: radial-gradient(120% 100% at 70% 30%, #000 30%, transparent 85%);
    mask-image: radial-gradient(120% 100% at 70% 30%, #000 30%, transparent 85%);
  }

  .carousel-slide__glow {
    @apply pointer-events-none absolute -right-40 -top-52 h-[680px] w-[680px];
    background: radial-gradient(circle, rgba(247, 162, 27, 0.16), transparent 62%);
  }

  .carousel-slide__content {
    @apply relative z-10 mx-auto flex w-full max-w-shell px-5 pb-24 pt-10 sm:px-6 lg:px-8;
  }

  .carousel-slide__text {
    @apply flex max-w-3xl flex-col items-start gap-5;
  }

  .carousel-slide__heading {
    @apply font-display font-bold uppercase text-white;
    font-size: clamp(2.2rem, 4.6vw, 3.6rem);
    line-height: 1.02;
    max-width: 17ch;
  }

  .carousel-slide__heading .field,
  .carousel-slide__heading .field__item {
    display: contents;
  }

  .carousel-slide__description {
    @apply max-w-[46ch] text-base leading-7 text-[#B9C5CF] sm:text-lg sm:leading-8;
  }

  .carousel-slide__description p {
    @apply m-0;
  }

  .carousel-slide__link a {
    @apply inline-flex items-center gap-3 rounded-brand bg-amber px-6 py-4 font-mono text-[13px] font-semibold uppercase tracking-[0.14em] text-ink transition-colors duration-200 hover:bg-amber-deep;
  }

  .carousel-slide__link a::after {
    @apply inline-block transition-transform duration-200;
    content: '\2192';
  }

  .carousel-slide__link a:hover::after {
    transform: translateX(4px);
  }

  /* Slide text entrance: elements stagger in when the slide activates. */

  .carousel-block .carousel-slide__text > * {
    opacity: 0;
    transform: translateY(16px);
    transition: opacity 0.55s theme('transitionTimingFunction.blueprint'),
      transform 0.55s theme('transitionTimingFunction.blueprint');
  }

  .carousel-block .splide__slide.is-active .carousel-slide__text > * {
    opacity: 1;
    transform: translateY(0);
  }

  .carousel-block .splide__slide.is-active .carousel-slide__text > :nth-child(1) {
    transition-delay: 0.15s;
  }

  .carousel-block .splide__slide.is-active .carousel-slide__text > :nth-child(2) {
    transition-delay: 0.25s;
  }

  .carousel-block .splide__slide.is-active .carousel-slide__text > :nth-child(3) {
    transition-delay: 0.35s;
  }

  .carousel-block .splide__slide.is-active .carousel-slide__text > :nth-child(4) {
    transition-delay: 0.45s;
  }

  /* Foot strip holding the progress indicators */

  .carousel-block .splide__pagination {
    @apply absolute inset-x-0 bottom-0 z-20 m-0 flex items-center justify-end gap-2 border-t border-line-dark;
    height: 62px;
    background: rgba(9, 18, 28, 0.5);
    backdrop-filter: blur(2px);
    padding-inline: max(1.25rem, calc((100% - 77.5rem) / 2 + 2rem));
  }

  .carousel-block .splide__pagination li {
    @apply flex items-center;
  }

  .carousel-block .splide__pagination__page {
    @apply relative h-1.5 w-[46px] overflow-hidden rounded-full bg-line-dark-2 opacity-100 shadow-none;
    transition: width 0.35s theme('transitionTimingFunction.blueprint');
  }

  .carousel-block .splide__pagination__page.is-active {
    @apply pointer-events-none w-[66px] cursor-default bg-line-dark-2;
    transform: none;
  }

  .carousel-block .splide__pagination__page::after {
    @apply absolute inset-y-0 left-0 rounded-full bg-amber;
    content: '';
    width: calc(var(--carousel-progress, 0) * 100%);
  }

  /* ── Informational block ("who we are") ──────────── */

  .informational-block {
    @apply bg-paper py-14 sm:py-16 xl:py-24;
  }

  .informational-block__inner {
    @apply mx-auto grid max-w-shell items-center gap-10 px-5 sm:px-6 lg:grid-cols-[1.05fr_0.95fr] lg:gap-16 lg:px-8;
  }

  .informational-block--no-image .informational-block__inner {
    @apply lg:grid-cols-1;
  }

  .informational-block__content {
    @apply flex min-w-0 flex-col items-start gap-5;
  }

  .informational-block__heading {
    @apply max-w-[20ch] font-display font-bold uppercase text-ink;
    font-size: clamp(1.9rem, 3.4vw, 2.9rem);
    line-height: 1.05;
  }

  .informational-block__heading .field,
  .informational-block__heading .field__item {
    display: contents;
  }

  .informational-block__description {
    @apply max-w-[54ch] text-[15px] leading-7 text-slate sm:text-base;
  }

  .informational-block__description p {
    @apply mb-4 last:mb-0;
  }

  .informational-block__items {
    @apply mt-2 grid w-full gap-4;
  }

  .informational-block__items:has(.informational-block-item:nth-child(2)) {
    @apply sm:grid-cols-2;
  }

  .informational-block-item {
    @apply min-w-0 rounded-brand border border-paper-line border-t-[3px] border-t-amber bg-white p-6;
  }

  .informational-block-item__heading {
    @apply mb-3 font-mono text-xs font-semibold uppercase tracking-[0.2em] text-amber-deep;
  }

  .informational-block-item__heading::before {
    content: '// ';
  }

  .informational-block-item__heading .field,
  .informational-block-item__heading .field__item {
    display: contents;
  }

  .informational-block-item__description {
    @apply text-sm leading-6 text-slate;
  }

  .informational-block-item__description p {
    @apply mb-3 last:mb-0;
  }

  /* Visual: amber plate offset behind the photo + corner brackets */

  .informational-block__media {
    @apply relative order-first mx-auto w-full max-w-[440px] pr-4 pt-4 lg:order-none lg:mx-0 lg:justify-self-end;
  }

  .informational-block--image-left .informational-block__inner {
    @apply lg:grid-cols-[0.95fr_1.05fr];
  }

  .informational-block--image-left .informational-block__media {
    @apply lg:order-first lg:justify-self-start;
  }

  .informational-block__plate {
    @apply absolute right-0 top-0 z-0 h-3/5 w-2/3 rounded-brand bg-amber;
  }

  .informational-block__photo {
    @apply relative z-10 overflow-hidden;
    aspect-ratio: 4 / 5;
  }

  .informational-block__photo::before,
  .informational-block__photo::after {
    @apply pointer-events-none absolute z-20 h-5 w-5 border-2 border-amber;
    content: '';
  }

  .informational-block__photo::before {
    @apply left-0 top-0 border-b-0 border-r-0;
  }

  .informational-block__photo::after {
    @apply bottom-0 right-0 border-l-0 border-t-0;
  }

  .informational-block__photo > div,
  .informational-block__photo .field,
  .informational-block__photo .field__item,
  .informational-block__photo .media,
  .informational-block__photo .media__content {
    @apply h-full;
  }

  .informational-block__photo img {
    @apply h-full w-full object-cover object-center;
  }

  /* ── Statistics bar ──────────────────────────────── */

  .statistics-bar {
    @apply relative isolate overflow-hidden bg-ink py-14 text-white sm:py-16 xl:py-20;
  }

  .statistics-bar__pattern {
    @apply pointer-events-none absolute inset-0 opacity-60;
    background-image: linear-gradient(90deg, rgba(255, 255, 255, 0.07) 1px, transparent 1px);
    background-size: 160px 100%;
  }

  .statistics-bar__media,
  .statistics-bar__media .field,
  .statistics-bar__media .field__item,
  .statistics-bar__media .media,
  .statistics-bar__media .media__content {
    @apply absolute inset-0 h-full;
  }

  .statistics-bar__media img {
    @apply h-full w-full object-cover object-center;
  }

  .statistics-bar__overlay {
    @apply absolute inset-0;
    background-image: linear-gradient(
      90deg,
      rgba(12, 26, 41, 0.92) 0%,
      rgba(12, 26, 41, 0.8) 50%,
      rgba(12, 26, 41, 0.9) 100%
    );
  }

  .statistics-bar__inner {
    @apply relative z-10 mx-auto max-w-shell px-5 sm:px-6 lg:px-8;
  }

  .statistics-bar__head {
    @apply mb-10 flex flex-wrap items-end justify-between gap-x-8 gap-y-5;
  }

  .statistics-bar__head-main {
    @apply flex flex-col items-start gap-3.5;
  }

  .statistics-bar__heading {
    @apply font-display font-bold uppercase text-white;
    font-size: clamp(1.7rem, 3vw, 2.5rem);
  }

  .statistics-bar__heading .field,
  .statistics-bar__heading .field__item {
    display: contents;
  }

  .statistics-bar__description {
    @apply max-w-[42ch] text-sm leading-6 text-steelgray;
  }

  .statistics-bar__description p {
    @apply m-0;
  }

  .statistics-bar__items {
    @apply grid gap-px border border-line-dark bg-line-dark sm:grid-cols-2 xl:grid-cols-4;
  }

  .statistics-bar-item {
    @apply relative bg-ink p-7 text-left transition-colors duration-300 sm:p-8;
  }

  .statistics-bar-item:hover {
    @apply bg-panel;
  }

  .statistics-bar--has-image .statistics-bar-item {
    background-color: rgba(12, 26, 41, 0.88);
  }

  .statistics-bar--has-image .statistics-bar-item:hover {
    background-color: rgba(22, 41, 59, 0.92);
  }

  .statistics-bar-item__tick {
    @apply absolute right-6 top-6 text-sm text-amber opacity-50;
  }

  .statistics-bar-item__value {
    @apply font-display font-bold leading-none text-white;
    font-size: clamp(2.6rem, 4vw, 3.6rem);
    letter-spacing: 0.01em;
  }

  .statistics-bar-item__value .field,
  .statistics-bar-item__value .field__item {
    display: contents;
  }

  .statistics-bar-item__unit {
    @apply ml-1 text-[0.5em] text-amber;
  }

  .statistics-bar-item__heading {
    @apply mb-2 mt-3.5 font-display text-[17px] font-medium uppercase tracking-[0.04em] text-white;
  }

  .statistics-bar-item__heading .field,
  .statistics-bar-item__heading .field__item {
    display: contents;
  }

  .statistics-bar-item__description {
    @apply max-w-[30ch] text-[13px] leading-6 text-steelgray;
  }

  .statistics-bar-item__description p {
    @apply m-0;
  }

  .statistics-bar-item__indicator {
    @apply absolute right-5 top-5 inline-flex h-9 w-9 items-center justify-center rounded-full border border-line-dark-2 bg-white/5 text-[0] text-steel-100 transition duration-200;
  }

  .statistics-bar-item__indicator::before {
    @apply text-sm font-semibold;
    content: '\2197';
    transition: transform 0.2s ease;
  }

  .statistics-bar-item:hover .statistics-bar-item__indicator {
    @apply border-amber bg-amber text-ink;
  }

  .statistics-bar-item:hover .statistics-bar-item__indicator::before {
    transform: translate3d(2px, -2px, 0);
  }

  /* ── Segments grid ───────────────────────────────── */

  .segments-block {
    @apply bg-paper py-14 sm:py-16 xl:py-24;
  }

  .segments-block__inner {
    @apply mx-auto max-w-shell px-5 sm:px-6 lg:px-8;
  }

  .segments-block__head {
    @apply mb-10 flex flex-wrap items-end justify-between gap-x-8 gap-y-5;
  }

  .segments-block__head-main {
    @apply flex flex-col items-start gap-3.5;
  }

  .segments-block__heading {
    @apply max-w-[18ch] font-display font-bold uppercase text-ink;
    font-size: clamp(1.9rem, 3.4vw, 2.9rem);
    line-height: 1.05;
  }

  .segments-block__heading .field,
  .segments-block__heading .field__item {
    display: contents;
  }

  .segments-block__description {
    @apply max-w-[44ch] text-sm leading-6 text-slate;
  }

  .segments-block__description p {
    @apply m-0;
  }

  .segments-block__grid {
    @apply grid gap-5 sm:grid-cols-2 xl:grid-cols-4;
    counter-reset: segment;
  }

  /*
   * Card anatomy (bottom-up): media (absolute, full card) → scrim →
   * spacer (flexible "thumbnail window") → panel with an ink ::before
   * cover. Hover dissolves the cover so the image reads as expanding
   * into the card background.
   */
  .segment-card {
    @apply relative isolate flex min-h-[29rem] flex-col overflow-hidden rounded-brand bg-ink text-white shadow-sm;
    counter-increment: segment;
    transition: transform 0.3s theme('transitionTimingFunction.blueprint'), box-shadow 0.3s ease;
  }

  /* Amber corner brackets */
  .segment-card::before,
  .segment-card::after {
    @apply pointer-events-none absolute z-20 h-5 w-5 border-2 border-amber;
    content: '';
  }

  .segment-card::before {
    @apply left-0 top-0 border-b-0 border-r-0;
  }

  .segment-card::after {
    @apply bottom-0 right-0 border-l-0 border-t-0;
  }

  .segment-card__media {
    @apply absolute inset-0 z-0 overflow-hidden;
  }

  /* Stable9 renders field/media wrappers as classless divs — stretch them all. */
  .segment-card__media div,
  .segment-card__media picture,
  .segment-card__media article {
    @apply absolute inset-0;
  }

  .segment-card__media img {
    @apply absolute inset-0 h-full w-full object-cover object-center;
    transition: transform 0.7s theme('transitionTimingFunction.blueprint');
  }

  /* Always-on soft scrim keeping the photo → panel seam clean */
  .segment-card__media::before {
    @apply absolute inset-0 z-[1];
    content: '';
    background: linear-gradient(180deg, transparent 45%, rgba(12, 26, 41, 0.5) 100%);
  }

  /* Auto-numbered code badge */
  .segment-card__media::after {
    @apply absolute left-3.5 top-3.5 z-[2] rounded-sm bg-amber px-2 py-1 font-mono text-[11px] font-medium tracking-[0.16em] text-ink;
    content: counter(segment, decimal-leading-zero);
  }

  .segment-card--no-image .segment-card__media {
    @apply bg-ink-soft;
    background-image: linear-gradient(rgba(255, 255, 255, 0.06) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.06) 1px, transparent 1px);
    background-size: 26px 26px;
  }

  /* Hover scrim: darkens the revealed background for text legibility */
  .segment-card__scrim {
    @apply pointer-events-none absolute inset-0 z-[1] opacity-0;
    background: linear-gradient(
      180deg,
      rgba(12, 26, 41, 0.5) 0%,
      rgba(12, 26, 41, 0.25) 30%,
      rgba(12, 26, 41, 0.6) 60%,
      rgba(12, 26, 41, 0.9) 100%
    );
    transition: opacity 0.5s ease;
  }

  /* Flexible "thumbnail window" above the panel */
  .segment-card__spacer {
    @apply relative z-[2];
    flex: 1 1 11rem;
    min-height: 10rem;
  }

  .segment-card__panel {
    @apply relative z-10 flex flex-col gap-2.5 p-6;
  }

  /* The ink cover that dissolves on hover */
  .segment-card__panel::before {
    @apply absolute inset-0 bg-ink;
    content: '';
    z-index: -1;
    transition: opacity 0.5s ease;
  }

  .segment-card__heading {
    @apply font-display text-[22px] font-semibold uppercase tracking-[0.03em] text-white;
  }

  .segment-card__heading .field,
  .segment-card__heading .field__item {
    display: contents;
  }

  .segment-card__desc {
    @apply text-sm leading-6 text-[#AEB9C3];
  }

  .segment-card__desc p {
    @apply m-0;
  }

  /*
   * Preview text: overlays the revealed image area above the panel.
   * It takes no layout space, so hovering never resizes anything —
   * the reveal is purely opacity/transform.
   */
  .segment-card__preview {
    @apply pointer-events-none absolute bottom-full left-0 right-0 px-6 pb-3 opacity-0;
    transform: translateY(8px);
    transition: opacity 0.4s ease, transform 0.4s theme('transitionTimingFunction.blueprint');
  }

  .segment-card__preview-inner {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 5;
    overflow: hidden;
  }

  .segment-card__preview-inner p {
    @apply m-0 text-sm leading-6 text-[#E2E8EE];
    text-shadow: 0 1px 10px rgba(12, 26, 41, 0.65);
  }

  .segment-card__link {
    @apply mt-1.5 inline-flex items-center gap-2.5 self-start border-t border-line-dark pt-3 font-mono text-xs uppercase tracking-[0.14em] text-amber;
  }

  .segment-card__link i {
    @apply text-[11px] transition-transform duration-200;
  }

  .segment-card__link:hover i {
    @apply translate-x-1;
  }

  /* Reveal on keyboard focus — any device */
  .segment-card:focus-within {
    transform: translateY(-4px);
    box-shadow: 0 26px 50px rgba(12, 26, 41, 0.22);
  }

  .segment-card:focus-within .segment-card__media img {
    transform: scale(1.04);
  }

  .segment-card:focus-within .segment-card__panel::before {
    opacity: 0;
  }

  .segment-card:focus-within .segment-card__scrim {
    opacity: 1;
  }

  .segment-card:focus-within .segment-card__preview {
    opacity: 1;
    transform: translateY(0);
    transition-delay: 0.08s;
  }

  /* Reveal on hover — hover-capable fine pointers only */
  @media (hover: hover) and (pointer: fine) {
    .segment-card:hover {
      transform: translateY(-4px);
      box-shadow: 0 26px 50px rgba(12, 26, 41, 0.22);
    }

    .segment-card:hover .segment-card__media img {
      transform: scale(1.04);
    }

    .segment-card:hover .segment-card__panel::before {
      opacity: 0;
    }

    .segment-card:hover .segment-card__scrim {
      opacity: 1;
    }

    .segment-card:hover .segment-card__preview {
      opacity: 1;
      transform: translateY(0);
      transition-delay: 0.08s;
    }
  }

  /* ── Partner logos marquee ───────────────────────── */

  .partner-logos {
    @apply border-b border-paper-line bg-white py-11 sm:py-14 xl:py-16;
  }

  .partner-logos__inner {
    @apply mx-auto max-w-shell px-5 sm:px-6 lg:px-8;
  }

  .partner-logos__head {
    @apply mb-9 flex flex-wrap items-center gap-x-6 gap-y-2;
  }

  .partner-logos__rule {
    @apply h-px min-w-[40px] flex-1 bg-paper-line;
  }

  .partner-logos__count {
    @apply font-mono text-xs tracking-[0.1em] text-slate-soft;
  }

  .partner-logos__track {
    @apply overflow-hidden;
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
    mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
  }

  .partner-logos__row {
    @apply flex w-max;
    animation: partner-marquee 34s linear infinite;
  }

  .partner-logos__row:hover {
    animation-play-state: paused;
  }

  .partner-logos__group {
    @apply flex items-center gap-16 pr-16;
  }

  .partner-logo {
    @apply flex items-center gap-2.5 whitespace-nowrap font-display text-[22px] font-semibold uppercase tracking-[0.08em] text-[#A9B4BE] opacity-[0.85] transition-all duration-300;
  }

  .partner-logo:hover {
    @apply text-ink opacity-100;
  }

  .partner-logo__dotmark {
    @apply h-[18px] w-[18px] flex-shrink-0 rotate-45 border-2 border-current;
  }

  .partner-logo__name .field,
  .partner-logo__name .field__item {
    display: contents;
  }

  .partner-logo__image img {
    @apply h-10 w-auto max-w-[180px] object-contain transition-all duration-300;
    filter: grayscale(1);
    opacity: 0.75;
  }

  .partner-logo--image:hover img {
    filter: none;
    opacity: 1;
  }

  /* ── CTA strip ───────────────────────────────────── */

  .eyebrow--ink {
    @apply text-ink;
  }

  .eyebrow--ink::before {
    @apply bg-ink;
  }

  .cta-strip {
    @apply relative overflow-hidden bg-amber text-ink;
  }

  .cta-strip::before {
    @apply absolute inset-0 opacity-[0.14];
    content: '';
    background-image: linear-gradient(rgba(12, 26, 41, 0.6) 1px, transparent 1px),
      linear-gradient(90deg, rgba(12, 26, 41, 0.6) 1px, transparent 1px);
    background-size: 30px 30px;
    -webkit-mask-image: linear-gradient(90deg, #000, transparent 70%);
    mask-image: linear-gradient(90deg, #000, transparent 70%);
  }

  .cta-strip__inner {
    @apply relative z-10 mx-auto flex max-w-shell flex-wrap items-center justify-between gap-x-8 gap-y-6 px-5 py-10 sm:px-6 sm:py-12 lg:px-8 xl:py-14;
  }

  .cta-strip__text {
    @apply flex flex-col items-start gap-3.5;
  }

  .cta-strip__heading {
    @apply max-w-[22ch] font-display font-bold uppercase text-ink;
    font-size: clamp(1.7rem, 3.2vw, 2.6rem);
    line-height: 1.05;
  }

  .cta-strip__heading .field,
  .cta-strip__heading .field__item {
    display: contents;
  }

  .cta-strip__description {
    @apply max-w-[52ch] text-sm leading-6 text-ink/80;
  }

  .cta-strip__description p {
    @apply m-0;
  }

  .cta-strip__actions .btn i {
    @apply text-xs transition-transform duration-200;
  }

  .cta-strip__actions .btn:hover i {
    @apply translate-x-1;
  }

  /* ── Footer ──────────────────────────────────────── */

  .footer {
    @apply relative bg-ink text-[#9FACB8];
  }

  .footer::before {
    @apply absolute inset-x-0 top-0 h-[3px] bg-amber;
    content: '';
  }

  .footer__grid {
    @apply grid gap-10 py-14 sm:grid-cols-2 sm:py-16 lg:gap-12 xl:py-20;
  }

  @media (min-width: 1024px) {
    .footer__grid {
      grid-template-columns: 1.6fr 1fr 1.4fr;
    }

    .footer__grid:has(.footer__col--blocks) {
      grid-template-columns: 1.6fr 1fr 1fr 1.4fr;
    }
  }

  .footer__brand {
    @apply sm:col-span-2 lg:col-span-1;
  }

  .footer__logo {
    @apply mb-5 flex items-center gap-3;
  }

  .footer__logo img {
    @apply h-10 w-auto;
  }

  .footer__logo-text {
    @apply flex flex-col;
  }

  .footer__wordmark {
    @apply font-display text-[22px] font-bold uppercase leading-none tracking-[0.04em] text-white;
  }

  .footer__slogan {
    @apply mt-1 font-mono text-[9.5px] uppercase tracking-[0.34em] text-steelgray;
  }

  .footer__text {
    @apply mb-6 max-w-[36ch] text-sm leading-6 text-steelgray;
  }

  .footer__socials {
    @apply flex gap-2;
  }

  .footer__socials a {
    @apply flex h-9 w-9 items-center justify-center rounded-brand border border-line-dark text-sm text-[#C9D4DE] hover:border-amber hover:text-amber;
  }

  .footer__heading {
    @apply mb-5 font-mono text-xs font-semibold uppercase tracking-[0.2em] text-white;
  }

  .footer__heading::before {
    content: '// ';
  }

  .footer__links li {
    @apply mb-3;
  }

  .footer__links a {
    @apply text-sm text-[#9FACB8] transition-all duration-150 hover:pl-1 hover:text-amber;
  }

  .footer__col--blocks a {
    @apply text-sm text-[#9FACB8] hover:text-amber;
  }

  .footer__contact li {
    @apply mb-4 flex items-start gap-3 text-sm;
  }

  .footer__contact i {
    @apply mt-1 text-xs text-amber;
  }

  .footer__contact a {
    @apply text-[#9FACB8] hover:text-white;
  }

  .footer__quote {
    @apply mt-2;
  }

  .footer__bar {
    @apply border-t border-line-dark;
  }

  .footer__bar-inner {
    @apply flex flex-wrap items-center justify-between gap-x-6 gap-y-3 py-5;
  }

  .footer__bar-inner p {
    @apply font-mono text-xs tracking-[0.04em] text-steelgray;
  }

  .footer__legal {
    @apply flex flex-wrap gap-5;
  }

  .footer__legal a {
    @apply text-[12.5px] text-steelgray hover:text-white;
  }

  /* ── Catalogue view ──────────────────────────────── */

  .catalogue-view__layout {
    @apply grid gap-8 lg:grid-cols-[minmax(0,1fr)_20rem] lg:items-start xl:gap-12;
  }

  .catalogue-view__main {
    @apply min-w-0;
  }

  .catalogue-view__sidebar {
    @apply order-first lg:order-none;
  }

  .catalogue-view__toolbar {
    @apply mb-8 flex flex-col gap-4 border-b border-steel-200 pb-6 md:flex-row md:items-center md:justify-between;
  }

  .catalogue-view__summary {
    @apply text-sm text-steel-500;
  }

  .catalogue-sort {
    @apply flex items-center gap-3 self-start md:self-auto;
  }

  .catalogue-sort__label {
    @apply sr-only;
  }

  .catalogue-sort__control {
    @apply relative min-w-[16rem];
  }

  .catalogue-sort__select {
    @apply h-14 w-full appearance-none rounded-brand border border-steel-200 bg-white pl-5 pr-16 font-sans text-sm font-medium text-steel-700 shadow-sm outline-none transition focus:border-brand;
  }

  .catalogue-sort__icon {
    @apply pointer-events-none absolute inset-y-0 right-0 inline-flex w-14 items-center justify-center bg-steel-900 text-sm text-white;
  }

  .catalogue-grid {
    @apply grid gap-6 md:grid-cols-2 xl:grid-cols-2 2xl:grid-cols-3;
  }

  .catalogue-grid__item {
    @apply min-w-0;
  }

  .catalogue-sidebar-card {
    @apply rounded-brand border border-steel-200 bg-white shadow-sm;
  }

  .catalogue-sidebar-card__title {
    @apply border-b border-steel-200 px-5 py-5 font-display text-2xl font-semibold uppercase text-steel-900;
  }

  .catalogue-search {
    @apply p-5;
  }

  .catalogue-search__control {
    @apply flex;
  }

  .catalogue-search__input {
    @apply h-14 min-w-0 flex-1 border border-r-0 border-steel-200 bg-white px-4 text-sm text-steel-700 outline-none placeholder:text-steel-400 focus:border-brand;
  }

  .catalogue-search__submit {
    @apply inline-flex h-14 w-14 items-center justify-center bg-brand text-ink transition hover:bg-brand-dark;
  }

  .catalogue-card {
    @apply mb-0 h-full rounded-brand border border-steel-200 bg-white shadow-sm transition duration-200 hover:-translate-y-1 hover:shadow-panel;
  }

  .catalogue-card__link {
    @apply flex h-full flex-col;
  }

  .catalogue-card__media {
    @apply relative flex min-h-[18rem] items-center justify-center overflow-hidden bg-white p-8 sm:min-h-[22rem];
  }

  .catalogue-card__badge {
    @apply absolute right-4 top-4 z-10 inline-flex items-center rounded-sm bg-steel-900 px-3 py-2 font-mono text-xs font-semibold uppercase tracking-[0.12em] text-white;
  }

  .catalogue-card__image {
    @apply h-full max-h-[20rem] w-full object-contain;
  }

  .catalogue-card__placeholder {
    @apply flex h-full min-h-[14rem] w-full items-center justify-center bg-steel-100 font-display text-lg uppercase tracking-[0.12em] text-steel-400;
  }

  .catalogue-card__body {
    @apply flex flex-1 flex-col gap-2 border-t border-steel-200 px-5 py-5;
  }

  .catalogue-card__sku {
    @apply font-mono text-xs font-semibold uppercase tracking-[0.16em] text-steel-400;
  }

  .catalogue-card__title {
    @apply font-display text-2xl font-semibold uppercase leading-tight text-steel-900;
  }

  .catalogue-card__price {
    @apply mt-auto pt-1 text-base font-semibold text-brand-dark;
  }

  .catalogue-view__pager {
    @apply mt-10;
  }

  .catalogue-view__pager .pager__items {
    @apply flex flex-wrap items-center gap-2;
  }

  .catalogue-view__pager .pager__item a,
  .catalogue-view__pager .pager__item.is-active a,
  .catalogue-view__pager .pager__item.is-active {
    @apply inline-flex h-11 min-w-[2.75rem] items-center justify-center rounded-brand border border-steel-200 bg-white px-4 text-sm font-semibold text-steel-700 transition hover:border-brand hover:text-brand-dark;
  }

  /* ── Misc ────────────────────────────────────────── */

  .node__content p,
  .node__content ul,
  .node__content ol {
    @apply mb-4 leading-normal;
  }

  [id$='-local-tasks'] {
    @apply mb-6;
  }

  [id$='-local-tasks'] > ul {
    @apply flex flex-wrap items-center gap-3 rounded-brand border border-steel-200 bg-white p-3 shadow-sm;
  }

  [id$='-local-tasks'] > ul > li {
    @apply m-0 list-none;
  }

  [id$='-local-tasks'] > ul > li > a,
  [id$='-local-tasks'] > ul > li > span {
    @apply inline-flex items-center rounded-brand border border-steel-200 px-4 py-2 text-sm font-semibold text-steel-700 hover:border-brand hover:bg-brand hover:text-ink;
  }

  [id$='-local-tasks'] > ul > li > a.is-active,
  [id$='-local-tasks'] > ul > li > span.is-active {
    @apply border-brand bg-brand text-ink;
  }

  .messages {
    @apply rounded-brand border border-steel-200 bg-white p-4 shadow-sm;
  }
}

/*
 * Runtime-injected markup (jQuery UI dialog, webform elements) is NOT in
 * Tailwind's content scan, so these rules live outside @layer to escape
 * tree-shaking.
 */
/* ── Quote modal (jQuery UI dialog skin) ─────────── */

/* Logged-in users get blocks wrapped in a positioned .contextual-region,
   which would re-anchor the full-width mega panel to the narrow menu block
   instead of the navbar — neutralize it inside the navbar. */
.navbar .contextual-region {
  position: static;
}

/* Core injects a throbber next to use-ajax triggers while the dialog
   loads, shifting the button for a moment — suppress it entirely. */
.ajax-progress-throbber,
.ajax-progress.ajax-progress-throbber {
  display: none;
}

.ui-widget-overlay,
.ui-widget-overlay.ui-front {
  @apply fixed inset-0 z-[100] bg-ink-deep/60;
  opacity: 1;
}

.ui-dialog.quote-modal,
.ui-dialog.quote-modal:not(.ui-dialog-off-canvas) {
  /* Gin/Claro dialog CSS piggybacks on the AJAX response and paints with
     these variables; defining them here makes those rules resolve to our
     palette instead of transparent. */
  --gin-bg-layer: #ffffff;
  --gin-bg-app: #f4f6f8;
  @apply z-[110] overflow-hidden rounded-brand border-0 bg-white p-0 font-sans shadow-panel;
  border-top: 3px solid theme('colors.amber.DEFAULT');
  max-width: min(46rem, calc(100vw - 2rem));
}

.ui-dialog.quote-modal .ui-widget-content.ui-dialog-content {
  @apply border-0 bg-white p-6 text-ink;
}

.ui-dialog.quote-modal .ui-dialog-buttonpane,
.ui-dialog.quote-modal .ui-widget-content.ui-dialog-buttonpane {
  @apply m-0 flex justify-end rounded-none border-0 border-t border-solid border-paper-line bg-paper px-6 py-4;
}

.ui-dialog.quote-modal .ui-dialog-buttonpane .ui-dialog-buttonset {
  @apply flex gap-3 whitespace-normal;
}

.ui-dialog.quote-modal .ui-dialog-buttonpane button,
.ui-dialog.quote-modal .ui-dialog-buttonpane .ui-dialog-buttonset button.ui-button {
  @apply m-0 inline-flex cursor-pointer items-center justify-center gap-3 rounded-brand border-0 bg-amber font-mono text-[13px] font-semibold uppercase tracking-[0.14em] text-ink transition-colors duration-200 hover:bg-amber-deep;
  padding: 0.875rem 1.5rem;
}

.ui-dialog.quote-modal .ui-dialog-titlebar .ui-dialog-titlebar-close {
  @apply absolute right-4 top-1/2 flex h-9 w-9 -translate-y-1/2 items-center justify-center overflow-hidden rounded-brand border border-solid border-paper-line bg-white p-0 text-slate transition-colors hover:border-amber hover:text-ink;
  background-image: none;
  text-indent: 0;
  /* Collapse the button's "Close" text node; the × comes from ::before. */
  font-size: 0;
}

.ui-dialog.quote-modal .ui-dialog-titlebar .ui-dialog-titlebar-close span {
  @apply hidden;
}

.ui-dialog.quote-modal .ui-dialog-titlebar .ui-dialog-titlebar-close::before {
  @apply leading-none;
  content: '\00d7';
  font-size: 1.05rem;
}

.ui-dialog.quote-modal .ui-dialog-titlebar {
  @apply relative flex items-center justify-between rounded-none border-0 border-b border-paper-line bg-white px-6 py-4;
}

.ui-dialog.quote-modal .ui-dialog-title {
  @apply font-display text-xl font-bold uppercase tracking-[0.03em] text-ink;
}

.ui-dialog.quote-modal .ui-dialog-titlebar-close {
  @apply absolute right-4 top-1/2 flex h-9 w-9 -translate-y-1/2 items-center justify-center overflow-hidden rounded-brand border border-paper-line bg-white p-0 text-slate transition-colors hover:border-amber hover:text-ink;
}

.ui-dialog.quote-modal .ui-dialog-titlebar-close .ui-icon {
  @apply hidden;
}

.ui-dialog.quote-modal .ui-dialog-titlebar-close::before {
  @apply text-base leading-none;
  content: '\00d7';
}

.ui-dialog.quote-modal .ui-dialog-content {
  @apply max-h-[75vh] overflow-y-auto p-6;
}

/* ── Webform elements (modal + standalone page) ──── */

.webform-submission-form {
  @apply flex flex-col gap-4 text-left font-sans text-ink;
}

.webform-submission-form .form-item {
  @apply m-0;
}

.webform-submission-form label {
  @apply mb-1.5 block font-mono text-xs font-medium uppercase tracking-[0.14em] text-slate;
}

.webform-submission-form .form-required::after {
  @apply ml-1 text-amber-deep;
  content: '*';
}

.webform-submission-form input[type='text'],
.webform-submission-form input[type='email'],
.webform-submission-form input[type='tel'],
.webform-submission-form input[type='number'],
.webform-submission-form input[type='url'],
.webform-submission-form input[type='date'],
.webform-submission-form textarea,
.webform-submission-form select {
  @apply w-full rounded-brand border border-paper-line bg-paper px-3.5 py-3 text-[15px] text-ink outline-none transition-all duration-200;
}

.webform-submission-form input:focus,
.webform-submission-form textarea:focus,
.webform-submission-form select:focus {
  @apply border-amber bg-white;
  box-shadow: 0 0 0 3px rgba(247, 162, 27, 0.16);
}

.webform-submission-form .form-actions {
  @apply mt-2 flex flex-wrap gap-3;
}

.webform-submission-form .webform-button--submit {
  @apply inline-flex cursor-pointer items-center justify-center gap-3 rounded-brand border-0 bg-amber px-6 py-3.5 font-mono text-[13px] font-semibold uppercase tracking-[0.14em] text-ink transition-colors duration-200 hover:bg-amber-deep;
}

.webform-confirmation__message {
  @apply text-[15px] leading-7 text-ink;
}

.webform-confirmation__back {
  @apply hidden;
}

@keyframes partner-marquee {
  to {
    transform: translateX(-50%);
  }
}

/* Reduced motion: no slide entrances, no marquee-style transitions. */
@media (prefers-reduced-motion: reduce) {
  .carousel-block .carousel-slide__text > * {
    opacity: 1;
    transform: none;
    transition: none;
  }

  .nav-drawer,
  .navbar .mega,
  .nav-drawer [data-menu-panel] {
    transition: none;
  }

  .partner-logos__row {
    animation: none;
  }

  .segment-card,
  .segment-card__media img,
  .segment-card__scrim,
  .segment-card__panel::before,
  .segment-card__preview {
    transition: none;
  }
}

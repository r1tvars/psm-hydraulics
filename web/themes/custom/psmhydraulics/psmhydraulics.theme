<?php

declare(strict_types=1);

/**
 * @file
 * Theme hooks and preprocessors for the PSM Hydraulics theme.
 */

use Drupal\Core\Menu\MenuTreeParameters;
use Drupal\Core\Url;

/**
 * Builds a flat list of first-level links for the given menu.
 *
 * @return array<int, array{title: string, url: string}>
 */
function _psmhydraulics_menu_links(string $menu_name): array {
  $menu_tree = \Drupal::menuTree();

  $parameters = new MenuTreeParameters();
  $parameters->setMaxDepth(1)->onlyEnabledLinks();

  $tree = $menu_tree->load($menu_name, $parameters);
  $tree = $menu_tree->transform($tree, [
    ['callable' => 'menu.default_tree_manipulators:checkAccess'],
    ['callable' => 'menu.default_tree_manipulators:generateIndexAndSort'],
  ]);

  $links = [];
  foreach ($tree as $element) {
    if (!$element->access || !$element->access->isAllowed()) {
      continue;
    }
    $links[] = [
      'title' => (string) $element->link->getTitle(),
      'url' => $element->link->getUrlObject()->toString(),
    ];
  }

  return $links;
}

/**
 * Resolves the site-wide quote CTA target from psm_site settings.
 *
 * Prefers the configured webform (opened in a modal) and falls back to a
 * plain link. Returns NULL when neither is set. Appends the webform's cache
 * tags to the given array.
 *
 * @return array{url: string, modal: bool}|null
 */
function _psmhydraulics_quote_link(array &$cache_tags): ?array {
  $config = \Drupal::config('psm_site.settings');

  $quote_webform_id = trim((string) $config->get('quote_webform'));
  if ($quote_webform_id !== '' && \Drupal::moduleHandler()->moduleExists('webform')) {
    $quote_webform = \Drupal::entityTypeManager()->getStorage('webform')->load($quote_webform_id);
    if ($quote_webform && $quote_webform->isOpen()) {
      $cache_tags = array_merge($cache_tags, $quote_webform->getCacheTags());
      return [
        'url' => $quote_webform->toUrl()->toString(),
        'modal' => TRUE,
      ];
    }
  }

  $quote_url = trim((string) $config->get('quote_url'));
  if ($quote_url !== '') {
    return [
      'url' => $quote_url,
      'modal' => FALSE,
    ];
  }

  return NULL;
}

/**
 * Implements hook_preprocess_page().
 */
function psmhydraulics_preprocess_page(array &$variables): void {
  $config = \Drupal::config('psm_site.settings');
  $site_config = \Drupal::config('system.site');

  $phone = (string) $config->get('phone');

  $variables['psm_site_contact'] = [
    'phone' => $phone,
    'phone_href' => 'tel:' . preg_replace('/[^0-9+]/', '', $phone),
    'email' => (string) $config->get('email'),
    'location' => (string) $config->get('location'),
  ];

  $social_definitions = [
    'facebook_url' => ['label' => 'Facebook', 'icon' => 'fa-brands fa-facebook-f'],
    'x_url' => ['label' => 'X', 'icon' => 'fa-brands fa-x-twitter'],
    'linkedin_url' => ['label' => 'LinkedIn', 'icon' => 'fa-brands fa-linkedin-in'],
    'instagram_url' => ['label' => 'Instagram', 'icon' => 'fa-brands fa-instagram'],
  ];

  $variables['psm_site_socials'] = [];
  foreach ($social_definitions as $key => $definition) {
    $url = trim((string) $config->get($key));
    if ($url !== '') {
      $variables['psm_site_socials'][] = $definition + ['url' => $url];
    }
  }

  // Quote buttons: prefer the configured webform (opened in a modal),
  // fall back to a plain link, hide when neither is set.
  $variables['#cache']['tags'] = $variables['#cache']['tags'] ?? [];
  $variables['psm_site_quote'] = _psmhydraulics_quote_link($variables['#cache']['tags']);

  // Header search: submits to the products view, suggestions come from
  // the psm_site JSON endpoint.
  $variables['psm_site_search'] = [
    'action' => '',
    'suggest_url' => '',
  ];
  try {
    $variables['psm_site_search']['action'] = Url::fromRoute('view.products.page_1')->toString();
    $variables['psm_site_search']['suggest_url'] = Url::fromRoute('psm_site.search_suggest')->toString();
  }
  catch (\Exception $exception) {
    // Products view or suggest route unavailable: the search box is hidden.
  }

  // The products listing and the product detail page render their own
  // breadcrumbs inside their page head bands, and the front page has nowhere
  // to go back to — drop the system block in all three cases.
  $route_match = \Drupal::routeMatch();
  $route_node = $route_match->getParameter('node');
  $route_term = $route_match->getParameter('taxonomy_term');
  if (
    $variables['is_front']
    || $route_match->getRouteName() === 'view.products.page_1'
    || ($route_match->getRouteName() === 'entity.node.canonical'
      && $route_node instanceof \Drupal\node\NodeInterface
      && $route_node->bundle() === 'catalogue_item')
    || ($route_match->getRouteName() === 'entity.taxonomy_term.canonical'
      && $route_term instanceof \Drupal\taxonomy\TermInterface
      && $route_term->bundle() === 'product_category')
  ) {
    $variables['page']['breadcrumb'] = [];
  }

  $variables['psm_site_footer'] = [
    'site_name' => (string) $site_config->get('name'),
    'slogan' => (string) $site_config->get('slogan'),
    'logo' => theme_get_setting('logo.url') ?: '',
    'text' => (string) $config->get('footer_text'),
    'year' => date('Y'),
    'menu' => _psmhydraulics_menu_links('main'),
    'legal' => _psmhydraulics_menu_links('footer'),
  ];

  $variables['#cache']['tags'] = array_merge(
    $variables['#cache']['tags'] ?? [],
    [
      'config:psm_site.settings',
      'config:system.site',
      'config:system.menu.main',
      'config:system.menu.footer',
    ],
  );
  $variables['#cache']['contexts'] = array_merge(
    $variables['#cache']['contexts'] ?? [],
    ['languages:language_interface', 'url.path.is_front'],
  );
}

/**
 * Implements hook_preprocess_links__language_block().
 */
function psmhydraulics_preprocess_links__language_block(array &$variables): void {
  $current_language = \Drupal::languageManager()->getCurrentLanguage();
  $current_language_id = $current_language->getId();
  $localized_labels = [
    'en' => [
      'en' => 'English',
      'en-gb' => 'English',
      'lv' => 'Latvian',
    ],
    'en-gb' => [
      'en' => 'English',
      'en-gb' => 'English',
      'lv' => 'Latvian',
    ],
    'lv' => [
      'en' => 'Angļu',
      'en-gb' => 'Angļu',
      'lv' => 'Latviešu',
    ],
  ];

  $flag_class_map = [
    'en' => 'fi fi-gb',
    'en-gb' => 'fi fi-gb',
    'lv' => 'fi fi-lv',
  ];

  $code_map = [
    'en' => 'EN',
    'en-gb' => 'EN',
    'lv' => 'LV',
  ];

  $label_map = $localized_labels[$current_language_id] ?? $localized_labels['en-gb'];
  $current_label = $label_map[$current_language_id] ?? ($label_map['en-gb'] ?? $current_language->getName());

  $variables['psm_language_switcher'] = [
    'current_label' => $current_label,
    'current_code' => $code_map[$current_language_id] ?? strtoupper($current_language_id),
    'current_flag_class' => $flag_class_map[$current_language_id] ?? 'fi',
    'items' => [],
  ];

  foreach ($variables['links'] as $langcode => $item) {
    $label = $label_map[$langcode] ?? $item['text'];
    $link = $item['link'] ?? NULL;

    if (is_array($link)) {
      $link['#title'] = $label;
      $link['#options']['attributes']['class'][] = 'language-switcher__link';
    }

    $variables['psm_language_switcher']['items'][] = [
      'flag_class' => $flag_class_map[$langcode] ?? 'fi',
      'code' => $code_map[$langcode] ?? strtoupper($langcode),
      'label' => $label,
      'is_active' => $langcode === $current_language_id,
      'link' => $link,
      'text' => $item['text'],
    ];
  }
}

/**
 * Implements hook_preprocess_paragraph__carousel_item().
 */
function psmhydraulics_preprocess_paragraph__carousel_item(array &$variables): void {
  $paragraph = $variables['paragraph'];

  if (!$paragraph->hasField('field_image') || $paragraph->get('field_image')->isEmpty()) {
    return;
  }

  $media = $paragraph->get('field_image')->entity;
  if (!$media || $media->bundle() !== 'video') {
    return;
  }

  if (!$media->hasField('field_media_video_file') || $media->get('field_media_video_file')->isEmpty()) {
    return;
  }

  $file = $media->get('field_media_video_file')->entity;
  if (!$file) {
    return;
  }

  $variables['carousel_video'] = [
    'url' => \Drupal::service('file_url_generator')->generateString($file->getFileUri()),
    'type' => (string) $file->getMimeType(),
  ];
}

/**
 * Implements hook_preprocess_paragraph__cta_strip().
 */
function psmhydraulics_preprocess_paragraph__cta_strip(array &$variables): void {
  $paragraph = $variables['paragraph'];

  if (!$paragraph->hasField('field_webform') || $paragraph->get('field_webform')->isEmpty()) {
    return;
  }

  $webform = $paragraph->get('field_webform')->entity;
  if (!$webform || !$webform->isOpen()) {
    return;
  }

  $label = '';
  if ($paragraph->hasField('field_button_label') && !$paragraph->get('field_button_label')->isEmpty()) {
    $label = trim((string) $paragraph->get('field_button_label')->value);
  }

  $variables['cta_webform'] = [
    'url' => $webform->toUrl()->toString(),
    'label' => $label !== '' ? $label : (string) t('Request a quote'),
  ];

  $variables['#cache']['tags'] = array_merge(
    $variables['#cache']['tags'] ?? [],
    $webform->getCacheTags(),
  );
}

/**
 * Implements hook_preprocess_paragraph__partner_logo_item().
 */
function psmhydraulics_preprocess_paragraph__partner_logo_item(array &$variables): void {
  $paragraph = $variables['paragraph'];

  if (!$paragraph->hasField('field_link') || $paragraph->get('field_link')->isEmpty()) {
    return;
  }

  $link_item = $paragraph->get('field_link')->first();

  $variables['partner_link'] = [
    'url' => $link_item->getUrl()->toString(),
    'new_tab' => $paragraph->hasField('field_open_in_new_tab')
      && !$paragraph->get('field_open_in_new_tab')->isEmpty()
      && (bool) $paragraph->get('field_open_in_new_tab')->value,
  ];
}

/**
 * Implements hook_preprocess_paragraph__segment_item().
 */
function psmhydraulics_preprocess_paragraph__segment_item(array &$variables): void {
  $paragraph = $variables['paragraph'];

  if (!$paragraph->hasField('field_link') || $paragraph->get('field_link')->isEmpty()) {
    return;
  }

  $link_item = $paragraph->get('field_link')->first();

  $variables['segment_link'] = [
    'url' => $link_item->getUrl()->toString(),
    'title' => (string) ($link_item->title ?: t('Explore segment')),
  ];
}

/**
 * Implements hook_preprocess_paragraph__statistics_bar_item().
 */
function psmhydraulics_preprocess_paragraph__statistics_bar_item(array &$variables): void {
  $paragraph = $variables['paragraph'];

  if (!$paragraph->hasField('field_link') || $paragraph->get('field_link')->isEmpty()) {
    return;
  }

  $link_item = $paragraph->get('field_link')->first();
  $url = $link_item->getUrl();
  $link_title = $link_item->title ?: t('Open statistic link');
  $open_in_new_tab = $paragraph->hasField('field_open_in_new_tab')
    && !$paragraph->get('field_open_in_new_tab')->isEmpty()
    && (bool) $paragraph->get('field_open_in_new_tab')->value;

  $options = $url->getOptions();
  $options['attributes']['class'][] = 'statistics-bar-item__indicator';
  $options['attributes']['aria-label'] = (string) $link_title;

  if ($open_in_new_tab) {
    $options['attributes']['target'] = '_blank';
    $options['attributes']['rel'] = 'noopener noreferrer';
  }

  $url->setOptions($options);

  $variables['statistics_bar_link'] = \Drupal\Core\Link::fromTextAndUrl(
    (string) t('Open'),
    $url,
  )->toRenderable();
}

/**
 * Implements hook_preprocess_node().
 */
function psmhydraulics_preprocess_node(array &$variables): void {
  $node = $variables['node'] ?? NULL;
  if (!$node instanceof \Drupal\node\NodeInterface || $node->bundle() !== 'catalogue_item') {
    return;
  }

  if (($variables['view_mode'] ?? '') === 'full') {
    _psmhydraulics_preprocess_product_full($variables, $node);
    return;
  }

  if (($variables['view_mode'] ?? '') !== 'teaser') {
    return;
  }

  $variables['catalogue_item_price_status'] = '';
  $variables['catalogue_item_sku'] = '';
  $variables['catalogue_item_category'] = '';
  $variables['catalogue_item_category_url'] = NULL;
  $variables['catalogue_item_glyph'] = 'tool';
  $variables['catalogue_item_manufacturer'] = '';
  $variables['catalogue_item_short_description'] = '';
  $variables['catalogue_item_availability'] = NULL;
  $variables['catalogue_item_datasheet_url'] = NULL;
  $variables['catalogue_item_image_uri'] = NULL;
  $variables['catalogue_item_image_url'] = NULL;
  $variables['catalogue_item_image_alt'] = $node->label();

  if ($node->hasField('field_price_status') && !$node->get('field_price_status')->isEmpty()) {
    $variables['catalogue_item_price_status'] = (string) $node->get('field_price_status')->value;
  }

  if ($node->hasField('field_sku') && !$node->get('field_sku')->isEmpty()) {
    $variables['catalogue_item_sku'] = (string) $node->get('field_sku')->value;
  }

  if ($node->hasField('field_manufacturer') && !$node->get('field_manufacturer')->isEmpty()) {
    $variables['catalogue_item_manufacturer'] = (string) $node->get('field_manufacturer')->value;
  }

  if ($node->hasField('field_short_description') && !$node->get('field_short_description')->isEmpty()) {
    $variables['catalogue_item_short_description'] = (string) $node->get('field_short_description')->value;
  }

  if ($node->hasField('field_availability') && !$node->get('field_availability')->isEmpty()) {
    $value = (string) $node->get('field_availability')->value;
    $allowed = $node->get('field_availability')->getFieldDefinition()
      ->getFieldStorageDefinition()->getSetting('allowed_values');
    $variables['catalogue_item_availability'] = [
      'value' => $value,
      'label' => (string) ($allowed[$value] ?? $value),
    ];
  }

  if ($node->hasField('field_datasheet') && !$node->get('field_datasheet')->isEmpty()) {
    $media = $node->get('field_datasheet')->entity;
    if ($media && $media->hasField('field_media_document') && !$media->get('field_media_document')->isEmpty()) {
      $file = $media->get('field_media_document')->entity;
      if ($file) {
        $variables['catalogue_item_datasheet_url'] = \Drupal::service('file_url_generator')
          ->generateString($file->getFileUri());
      }
    }
  }

  if ($node->hasField('field_product_category') && !$node->get('field_product_category')->isEmpty()) {
    $term = $node->get('field_product_category')->entity;
    if ($term) {
      $term = \Drupal::service('entity.repository')->getTranslationFromContext($term);
      $variables['catalogue_item_category'] = $term->label();
      $variables['catalogue_item_category_url'] = $term->toUrl()->toString();
      $variables['catalogue_item_glyph'] = _psmhydraulics_product_glyph($term->label());
    }
  }

  if ($node->hasField('field_product_images') && !$node->get('field_product_images')->isEmpty()) {
    $media = $node->get('field_product_images')->first()?->entity;
    if ($media && $media->hasField('field_media_image') && !$media->get('field_media_image')->isEmpty()) {
      $image_item = $media->get('field_media_image')->first();
      $file = $image_item?->entity;
      if ($file) {
        $file_uri = $file->getFileUri();
        $image_style = \Drupal::entityTypeManager()->getStorage('image_style')->load('large');

        $variables['catalogue_item_image_uri'] = $file_uri;
        $variables['catalogue_item_image_url'] = $image_style
          ? $image_style->buildUrl($file_uri)
          : \Drupal::service('file_url_generator')->generateString($file_uri);
        $variables['catalogue_item_image_alt'] = (string) ($image_item->alt ?: $node->label());
      }
    }
  }
}

/**
 * Builds everything the product detail template needs.
 */
function _psmhydraulics_preprocess_product_full(array &$variables, \Drupal\node\NodeInterface $node): void {
  $file_url_generator = \Drupal::service('file_url_generator');
  $image_styles = \Drupal::entityTypeManager()->getStorage('image_style');
  $large_style = $image_styles->load('large');
  $thumb_style = $image_styles->load('medium');

  $product = [
    'sku' => '',
    'manufacturer' => '',
    'category' => '',
    'category_url' => NULL,
    'category_trail' => [],
    'glyph' => 'tool',
    'price_status' => '',
    'short_description' => '',
    'availability' => NULL,
    'gallery' => [],
    'datasheet' => NULL,
    'facts' => [],
  ];

  foreach (['field_sku' => 'sku', 'field_manufacturer' => 'manufacturer', 'field_price_status' => 'price_status', 'field_short_description' => 'short_description'] as $field => $key) {
    if ($node->hasField($field) && !$node->get($field)->isEmpty()) {
      $product[$key] = (string) $node->get($field)->value;
    }
  }

  if (!$node->get('field_availability')->isEmpty()) {
    $value = (string) $node->get('field_availability')->value;
    $allowed = $node->get('field_availability')->getFieldDefinition()
      ->getFieldStorageDefinition()->getSetting('allowed_values');
    $product['availability'] = [
      'value' => $value,
      'label' => (string) ($allowed[$value] ?? $value),
    ];
  }

  $category_term = NULL;
  if (!$node->get('field_product_category')->isEmpty()) {
    $category_term = $node->get('field_product_category')->entity;
    if ($category_term) {
      $category_term = \Drupal::service('entity.repository')->getTranslationFromContext($category_term);
      $product['category'] = $category_term->label();
      $product['category_url'] = $category_term->toUrl()->toString();
      // Full chain, so the breadcrumb reads Home / Products / … / this product.
      $product['category_trail'] = _psmhydraulics_category_trail($category_term);
      $product['glyph'] = _psmhydraulics_product_glyph($category_term->label());
    }
  }

  // Gallery: every image media on the node, lead image first (field order).
  foreach ($node->get('field_product_images') as $item) {
    $media = $item->entity;
    if (!$media || !$media->hasField('field_media_image') || $media->get('field_media_image')->isEmpty()) {
      continue;
    }
    $image_item = $media->get('field_media_image')->first();
    $file = $image_item?->entity;
    if (!$file) {
      continue;
    }
    $uri = $file->getFileUri();
    $product['gallery'][] = [
      'large' => $large_style ? $large_style->buildUrl($uri) : $file_url_generator->generateString($uri),
      'thumb' => $thumb_style ? $thumb_style->buildUrl($uri) : $file_url_generator->generateString($uri),
      'alt' => (string) ($image_item->alt ?: $node->label()),
    ];
  }

  // Datasheet: media:document → file, with name and human size.
  if (!$node->get('field_datasheet')->isEmpty()) {
    $media = $node->get('field_datasheet')->entity;
    if ($media && $media->hasField('field_media_document') && !$media->get('field_media_document')->isEmpty()) {
      $file = $media->get('field_media_document')->entity;
      if ($file) {
        $product['datasheet'] = [
          'url' => $file_url_generator->generateString($file->getFileUri()),
          'name' => $file->getFilename(),
          'size' => \Drupal\Core\StringTranslation\ByteSizeMarkup::create((int) $file->getSize()),
        ];
      }
    }
  }

  // Key-facts table for the info panel.
  foreach ([
    (string) t('SKU') => $product['sku'],
    (string) t('Manufacturer') => $product['manufacturer'],
    (string) t('Category') => $product['category'],
    (string) t('Availability') => $product['availability']['label'] ?? '',
    (string) t('Price') => $product['price_status'],
  ] as $fact_label => $fact_value) {
    if ($fact_value !== '') {
      $product['facts'][] = ['label' => $fact_label, 'value' => $fact_value];
    }
  }

  // Long-text sections, labels suppressed (the template adds its own).
  $product['body'] = !$node->get('body')->isEmpty()
    ? $node->get('body')->view(['label' => 'hidden'])
    : NULL;
  $product['specifications'] = !$node->get('field_specifications')->isEmpty()
    ? $node->get('field_specifications')->view(['label' => 'hidden'])
    : NULL;

  $variables['#cache']['tags'] = $variables['#cache']['tags'] ?? [];
  $product['quote'] = _psmhydraulics_quote_link($variables['#cache']['tags']);

  // Related products: newest published items sharing the category.
  $variables['product_related'] = [];
  if ($category_term) {
    $related_ids = \Drupal::entityQuery('node')->accessCheck(TRUE)
      ->condition('type', 'catalogue_item')
      ->condition('status', 1)
      ->condition('field_product_category', $category_term->id())
      ->condition('nid', $node->id(), '<>')
      ->sort('created', 'DESC')
      ->range(0, 3)
      ->execute();
    if ($related_ids) {
      $storage = \Drupal::entityTypeManager()->getStorage('node');
      $variables['product_related'] = \Drupal::entityTypeManager()->getViewBuilder('node')
        ->viewMultiple($storage->loadMultiple($related_ids), 'teaser');
      $variables['#cache']['tags'][] = 'node_list:catalogue_item';
    }
  }

  $variables['product'] = $product;
  $variables['products_index_url'] = Url::fromRoute('view.products.page_1')->toString();
}

/**
 * Loads the product category tree with rolled-up product counts.
 *
 * A product carries exactly one category, so a term's subtree count is its
 * own published products plus those of every descendant — a plain sum that
 * cannot double-count.
 *
 * @return array
 *   Two arrays: terms keyed by parent tid then own tid (vocabulary order,
 *   each term listed once even if it has several parents), and subtree counts
 *   keyed by tid.
 */
function _psmhydraulics_product_category_tree(): array {
  $counts = _psmhydraulics_product_counts('node__field_product_category', 'field_product_category_target_id');

  $children = [];
  foreach (\Drupal::entityTypeManager()->getStorage('taxonomy_term')->loadTree('product_category', 0, NULL, TRUE) as $term) {
    // loadTree() attaches parents/depth to the untranslated entity, and lists
    // a multi-parent term once per path — key by tid so it appears once.
    $children[(int) reset($term->parents)][(int) $term->id()] = $term;
  }

  $subtree_counts = [];
  $walk = static function (int $parent_tid) use (&$walk, $children, $counts, &$subtree_counts): int {
    $total = 0;
    foreach ($children[$parent_tid] ?? [] as $term) {
      $count = ($counts[(string) $term->id()] ?? 0) + $walk((int) $term->id());
      $subtree_counts[(int) $term->id()] = $count;
      $total += $count;
    }
    return $total;
  };
  $walk(0);

  return [$children, $subtree_counts];
}

/**
 * Number of subcategory links shown per mega-menu column.
 */
const PSMHYDRAULICS_MENU_LINKS = 6;

/**
 * Implements hook_preprocess_menu().
 *
 * Hangs the product category tree off the Products link, so the main menu
 * opens a catalogue panel instead of editors having to mirror every category
 * as a menu link by hand. The same markup becomes the drawer accordion on
 * small screens, so this covers both.
 */
function psmhydraulics_preprocess_menu(array &$variables): void {
  if (($variables['menu_name'] ?? '') !== 'main' || empty($variables['items'])) {
    return;
  }

  foreach ($variables['items'] as &$item) {
    $url = $item['url'] ?? NULL;
    if (!$url instanceof Url || !$url->isRouted() || $url->getRouteName() !== 'view.products.page_1') {
      continue;
    }
    $columns = _psmhydraulics_category_menu_columns();
    if ($columns) {
      $item['below'] = $columns;
      $item['mega_foot'] = [
        'note' => (string) t('// @count line items in the catalogue', [
          '@count' => \Drupal::entityQuery('node')->accessCheck(FALSE)
            ->condition('type', 'catalogue_item')->condition('status', 1)
            ->count()->execute(),
        ]),
        'label' => (string) t('Browse all products'),
        'url' => $url->toString(),
      ];
    }
    break;
  }
  unset($item);

  // The panel is built from terms and a product count, neither of which the
  // menu's own cache metadata covers.
  $variables['#cache']['tags'][] = 'taxonomy_term_list:product_category';
  $variables['#cache']['tags'][] = 'node_list:catalogue_item';
}

/**
 * Builds the catalogue mega-menu columns from the product category tree.
 *
 * One column per top-level category that has products, listing its
 * subcategories; a column with more subcategories than fit ends with a link
 * through to the category page.
 */
function _psmhydraulics_category_menu_columns(): array {
  [$tree_children, $subtree_counts] = _psmhydraulics_product_category_tree();
  $entity_repository = \Drupal::service('entity.repository');
  $stocked = static fn ($term) => ($subtree_counts[(int) $term->id()] ?? 0) > 0;

  $columns = [];
  foreach (array_filter($tree_children[0] ?? [], $stocked) as $term) {
    $children = array_filter($tree_children[(int) $term->id()] ?? [], $stocked);
    $term = $entity_repository->getTranslationFromContext($term);

    $links = [];
    foreach (array_slice($children, 0, PSMHYDRAULICS_MENU_LINKS, TRUE) as $child) {
      $child = $entity_repository->getTranslationFromContext($child);
      $links[] = [
        'title' => $child->label(),
        'url' => $child->toUrl(),
        'below' => [],
        'in_active_trail' => FALSE,
      ];
    }
    if (count($children) > count($links)) {
      $links[] = [
        'title' => t('View all (@count)', ['@count' => count($children)]),
        'url' => $term->toUrl(),
        'below' => [],
        'in_active_trail' => FALSE,
      ];
    }
    elseif (!$links) {
      // A category with no subcategories would otherwise be a bare heading in
      // an empty column; point straight at its products instead.
      $count = $subtree_counts[(int) $term->id()] ?? 0;
      $links[] = [
        'title' => \Drupal::translation()->formatPlural($count, '1 product', '@count products'),
        'url' => $term->toUrl(),
        'below' => [],
        'in_active_trail' => FALSE,
      ];
    }

    $columns[] = [
      'title' => $term->label(),
      'url' => $term->toUrl(),
      'below' => $links,
      'in_active_trail' => FALSE,
    ];
  }

  return $columns;
}

/**
 * Returns the breadcrumb trail for a product category term.
 *
 * Root first, the term itself last, each entry {label, url}. Callers that
 * render the term as the current page pop the last entry.
 */
function _psmhydraulics_category_trail(\Drupal\taxonomy\TermInterface $term): array {
  $entity_repository = \Drupal::service('entity.repository');
  $trail = [];
  // loadAllParents() returns the term first and the root last.
  $chain = \Drupal::entityTypeManager()->getStorage('taxonomy_term')->loadAllParents($term->id());
  foreach (array_reverse($chain, TRUE) as $ancestor) {
    $ancestor = $entity_repository->getTranslationFromContext($ancestor);
    $trail[] = ['label' => $ancestor->label(), 'url' => $ancestor->toUrl()->toString()];
  }
  return $trail;
}

/**
 * Builds the data a category card template needs.
 *
 * The term must already be the translation for the current context.
 */
function _psmhydraulics_category_card(\Drupal\taxonomy\TermInterface $term, int $count): array {
  return [
    'label' => $term->label(),
    'count' => $count,
    'url' => $term->toUrl()->toString(),
    'image_url' => _psmhydraulics_category_image_url($term),
    'glyph' => _psmhydraulics_product_glyph($term->label()),
  ];
}

/**
 * Returns the card image URL for a product category term, if it has one.
 *
 * Categories reference a media image (field_category_image); terms without
 * one fall back to a schematic glyph in the template.
 */
function _psmhydraulics_category_image_url(\Drupal\taxonomy\TermInterface $term, string $style = 'large'): ?string {
  if (!$term->hasField('field_category_image') || $term->get('field_category_image')->isEmpty()) {
    return NULL;
  }
  $media = $term->get('field_category_image')->entity;
  if (!$media || !$media->hasField('field_media_image') || $media->get('field_media_image')->isEmpty()) {
    return NULL;
  }
  $file = $media->get('field_media_image')->first()?->entity;
  if (!$file) {
    return NULL;
  }
  $image_style = \Drupal::entityTypeManager()->getStorage('image_style')->load($style);
  return $image_style
    ? $image_style->buildUrl($file->getFileUri())
    : \Drupal::service('file_url_generator')->generateString($file->getFileUri());
}

/**
 * Maps a product category label to one of the schematic placeholder glyphs.
 */
function _psmhydraulics_product_glyph(string $category): string {
  $category = mb_strtolower($category);
  foreach ([
    'pump' => 'pump',
    'valve' => 'valve',
    'cylind' => 'cylinder',
    'hose' => 'hose',
    'fitting' => 'hose',
  ] as $needle => $glyph) {
    if (str_contains($category, $needle)) {
      return $glyph;
    }
  }
  return 'tool';
}

/**
 * Counts published products grouped by a field column.
 *
 * @return array<string, int>
 *   Keyed by the column value, sorted by count descending.
 */
function _psmhydraulics_product_counts(string $table, string $column): array {
  $connection = \Drupal::database();
  $query = $connection->select($table, 'f');
  $query->innerJoin('node_field_data', 'n', 'n.nid = f.entity_id AND n.langcode = f.langcode');
  $query->condition('n.status', 1)
    ->condition('n.type', 'catalogue_item')
    ->condition('n.default_langcode', 1)
    ->condition('f.deleted', 0);
  $query->addField('f', $column, 'value');
  $query->addExpression('COUNT(DISTINCT f.entity_id)', 'total');
  $query->groupBy("f.$column");
  $query->orderBy('total', 'DESC');

  $counts = [];
  foreach ($query->execute() as $row) {
    $counts[(string) $row->value] = (int) $row->total;
  }
  return $counts;
}

/**
 * Implements hook_preprocess_views_view().
 *
 * Builds everything the products listing template needs: filter options
 * with counts, current selections, removable filter chips, and the result
 * summary. The template renders the whole listing as one hand-built GET
 * form, so no Views exposed form is used.
 */
function psmhydraulics_preprocess_views_view(array &$variables): void {
  $view = $variables['view'] ?? NULL;
  if (!$view) {
    return;
  }

  // Product category term pages get their own landing-page treatment.
  if ($view->id() === 'taxonomy_term') {
    if ($term = _psmhydraulics_product_category_term($view)) {
      _psmhydraulics_preprocess_category_view($variables, $term);
    }
    return;
  }

  if ($view->id() !== 'products' || $view->current_display !== 'page_1') {
    return;
  }

  $input = $view->getExposedInput();
  $search = trim((string) ($input['search'] ?? ''));
  $sort_by = (string) ($input['sort_by'] ?? 'newest');
  $per_page = (int) ($input['items_per_page'] ?? 12);
  $doc = !empty($input['doc']);
  $selected = [
    'category' => array_map('strval', array_filter((array) ($input['category'] ?? []), 'is_numeric')),
    'manufacturer' => array_values(array_filter((array) ($input['manufacturer'] ?? []), 'is_string')),
    'availability' => array_values(array_filter((array) ($input['availability'] ?? []), 'is_string')),
  ];

  // Category options: the vocabulary tree as a nested structure, each term
  // included only if its subtree has published products. The sidebar renders
  // it as collapsible groups, so every option carries its own open/closed and
  // covered state:
  // - selected: the user ticked this term;
  // - covered:  an ancestor is ticked, so this term is already in the results
  //             (rendered ticked and disabled — checking a parent matches the
  //             whole subtree via psm_site_views_query_alter());
  // - expanded: this branch holds an active filter, so it opens on load.
  $entity_repository = \Drupal::service('entity.repository');
  [$tree_children, $subtree_counts] = _psmhydraulics_product_category_tree();
  $selected_categories = [];
  $build_category_options = static function (int $parent_tid, bool $ancestor_selected) use (&$build_category_options, $tree_children, $subtree_counts, $entity_repository, $selected, &$selected_categories): array {
    $options = [];
    foreach ($tree_children[$parent_tid] ?? [] as $term) {
      $count = $subtree_counts[(int) $term->id()] ?? 0;
      if ($count <= 0) {
        continue;
      }
      $is_selected = in_array((string) $term->id(), $selected['category'], TRUE);
      $label = $entity_repository->getTranslationFromContext($term)->label();
      if ($is_selected) {
        $selected_categories[] = ['value' => (string) $term->id(), 'label' => $label];
      }
      $children = $build_category_options((int) $term->id(), $ancestor_selected || $is_selected);
      $branch_active = (bool) array_filter($children, static fn (array $child) => $child['selected'] || $child['expanded']);
      $options[] = [
        'value' => (string) $term->id(),
        'label' => $label,
        'count' => $count,
        'selected' => $is_selected,
        'covered' => $ancestor_selected,
        'expanded' => $children !== [] && ($is_selected || $ancestor_selected || $branch_active),
        'children' => $children,
      ];
    }
    return $options;
  };
  $categories = $build_category_options(0, FALSE);

  // Manufacturer options: distinct values, busiest first.
  $manufacturers = [];
  foreach (_psmhydraulics_product_counts('node__field_manufacturer', 'field_manufacturer_value') as $value => $count) {
    if ($value !== '') {
      $manufacturers[] = [
        'value' => $value,
        'label' => $value,
        'count' => $count,
        'selected' => in_array($value, $selected['manufacturer'], TRUE),
      ];
    }
  }

  // Availability options: field order, with status dot modifiers.
  $availability_counts = _psmhydraulics_product_counts('node__field_availability', 'field_availability_value');
  $availability_dots = [
    'in_stock' => 'ok',
    'on_request' => 'request',
    'custom_order' => 'custom',
  ];
  $availability = [];
  $availability_storage = \Drupal::service('entity_field.manager')
    ->getFieldStorageDefinitions('node')['field_availability'] ?? NULL;
  foreach (($availability_storage?->getSetting('allowed_values') ?? []) as $value => $label) {
    $availability[] = [
      'value' => (string) $value,
      'label' => (string) $label,
      'count' => $availability_counts[(string) $value] ?? 0,
      'dot' => $availability_dots[$value] ?? 'custom',
      'selected' => in_array((string) $value, $selected['availability'], TRUE),
    ];
  }

  // Datasheet toggle count.
  $doc_count = (int) \Drupal::database()->select('node__field_datasheet', 'f')
    ->condition('f.deleted', 0)
    ->countQuery()->execute()->fetchField();

  // Query builder for chip-removal / reset links.
  $base_query = array_filter([
    'search' => $search !== '' ? $search : NULL,
    'sort_by' => $sort_by !== 'newest' ? $sort_by : NULL,
    'items_per_page' => $per_page !== 12 ? $per_page : NULL,
    'category' => $selected['category'] ?: NULL,
    'manufacturer' => $selected['manufacturer'] ?: NULL,
    'availability' => $selected['availability'] ?: NULL,
    'doc' => $doc ? 1 : NULL,
  ]);
  $url_without = static function (string $key, ?string $value = NULL) use ($base_query): string {
    $query = $base_query;
    if ($value === NULL) {
      unset($query[$key]);
    }
    else {
      $query[$key] = array_values(array_diff((array) ($query[$key] ?? []), [$value]));
      if (!$query[$key]) {
        unset($query[$key]);
      }
    }
    return Url::fromRoute('view.products.page_1', [], ['query' => $query])->toString();
  };

  // Removable chips for every active filter.
  $chips = [];
  foreach ($selected_categories as $option) {
    $chips[] = ['group' => (string) t('Cat'), 'label' => $option['label'], 'url' => $url_without('category', $option['value'])];
  }
  foreach ($manufacturers as $option) {
    if ($option['selected']) {
      $chips[] = ['group' => (string) t('Mfr'), 'label' => $option['label'], 'url' => $url_without('manufacturer', $option['value'])];
    }
  }
  foreach ($availability as $option) {
    if ($option['selected']) {
      $chips[] = ['group' => (string) t('Stock'), 'label' => $option['label'], 'url' => $url_without('availability', $option['value'])];
    }
  }
  if ($doc) {
    $chips[] = ['group' => (string) t('Doc'), 'label' => (string) t('Datasheet available'), 'url' => $url_without('doc')];
  }

  // "Browse by category" strip: top-level categories as image cards, shown
  // only on the unfiltered first page — once someone is searching, filtering
  // or paging, the result grid is what they are looking at.
  $browse = [];
  // The pager is not part of the exposed input, so the page comes from the
  // view itself.
  if ($search === '' && $chips === [] && (int) $view->getCurrentPage() === 0) {
    foreach ($tree_children[0] ?? [] as $term) {
      $count = $subtree_counts[(int) $term->id()] ?? 0;
      if ($count > 0) {
        $browse[] = _psmhydraulics_category_card($entity_repository->getTranslationFromContext($term), $count);
      }
    }
  }

  // Result summary + catalogue-wide total for the head counter.
  // Quote webform cache tags already bubble via the header CTA in
  // psmhydraulics_preprocess_page(), so the collector array is discarded.
  $quote_tags = [];
  $total = (int) $view->total_rows;
  $catalog_total = (int) \Drupal::entityQuery('node')->accessCheck(FALSE)
    ->condition('type', 'catalogue_item')
    ->condition('status', 1)
    ->count()->execute();

  // Page head band, customizable via PSM site settings ("Products page").
  // psm_site_views_pre_render() adds the config cache tag to this view.
  $site_config = \Drupal::config('psm_site.settings');
  $head = [
    'eyebrow' => trim((string) $site_config->get('products_eyebrow')) ?: (string) t('Product index'),
    'title' => trim((string) $site_config->get('products_title')) ?: (string) t('Products'),
    'intro' => trim((string) $site_config->get('products_intro')) ?: (string) t('Hydraulic pumps, valves, cylinders, hoses and service tooling — stocked components and custom-built assemblies from certified manufacturers.'),
    'show_counter' => (bool) ($site_config->get('products_show_counter') ?? TRUE),
    'bg_url' => NULL,
  ];
  $bg_fid = (int) ($site_config->get('products_bg') ?? 0);
  if ($bg_fid && ($bg_file = \Drupal::entityTypeManager()->getStorage('file')->load($bg_fid))) {
    $wide_style = \Drupal::entityTypeManager()->getStorage('image_style')->load('wide');
    $head['bg_url'] = $wide_style
      ? $wide_style->buildUrl($bg_file->getFileUri())
      : \Drupal::service('file_url_generator')->generateString($bg_file->getFileUri());
  }

  $variables['products_view'] = [
    'head' => $head,
    'action' => Url::fromRoute('view.products.page_1')->toString(),
    'reset_url' => Url::fromRoute('view.products.page_1')->toString(),
    'search' => $search,
    'sort_by' => $sort_by,
    'sort_options' => [
      'newest' => (string) t('Newest first'),
      'oldest' => (string) t('Oldest first'),
      'title_asc' => (string) t('Name A–Z'),
      'title_desc' => (string) t('Name Z–A'),
    ],
    'per_page' => $per_page,
    'per_page_options' => [12, 24, 48],
    'browse' => $browse,
    'categories' => $categories,
    'category_active' => count($selected_categories),
    'manufacturers' => $manufacturers,
    'availability' => $availability,
    'doc' => $doc,
    'doc_count' => $doc_count,
    'chips' => $chips,
    'active_count' => count($chips),
    'total' => $total,
    'catalog_total' => $catalog_total,
    'quote' => _psmhydraulics_quote_link($quote_tags),
  ];
}

/**
 * Returns the product category term a taxonomy_term view is rendering.
 *
 * Other vocabularies (tags, media directories) keep the stock term page, so
 * everything category-specific is gated on this.
 */
function _psmhydraulics_product_category_term($view): ?\Drupal\taxonomy\TermInterface {
  $tid = (int) ($view->args[0] ?? 0);
  if (!$tid) {
    return NULL;
  }
  $term = \Drupal::entityTypeManager()->getStorage('taxonomy_term')->load($tid);
  if (!$term instanceof \Drupal\taxonomy\TermInterface || $term->bundle() !== 'product_category') {
    return NULL;
  }
  return \Drupal::service('entity.repository')->getTranslationFromContext($term);
}

/**
 * Implements hook_theme_suggestions_views_view_alter().
 *
 * Gives product category term pages their own landing-page template, leaving
 * every other vocabulary on the stock one.
 */
function psmhydraulics_theme_suggestions_views_view_alter(array &$suggestions, array $variables): void {
  $view = $variables['view'] ?? NULL;
  if ($view && $view->id() === 'taxonomy_term' && _psmhydraulics_product_category_term($view)) {
    $suggestions[] = 'views_view__taxonomy_term__product_category';
  }
}

/**
 * Builds the category landing page: head band, child cards, product grid.
 *
 * The view itself lists the products (its argument matches the whole subtree,
 * so a parent category shows everything below it); this adds the navigation
 * around them.
 */
function _psmhydraulics_preprocess_category_view(array &$variables, \Drupal\taxonomy\TermInterface $term): void {
  $entity_repository = \Drupal::service('entity.repository');
  [$tree_children, $subtree_counts] = _psmhydraulics_product_category_tree();
  $tid = (int) $term->id();

  // Breadcrumbs: Home / Products / ancestors. This term itself is rendered as
  // the current page, so drop it off the end of the trail.
  $ancestors = _psmhydraulics_category_trail($term);
  array_pop($ancestors);
  $crumbs = array_merge([
    ['label' => (string) t('Home'), 'url' => Url::fromRoute('<front>')->toString()],
    ['label' => (string) t('Products'), 'url' => Url::fromRoute('view.products.page_1')->toString()],
  ], $ancestors);

  // Child categories, as the same cards the products page browse strip uses.
  $children = [];
  foreach ($tree_children[$tid] ?? [] as $child) {
    $count = $subtree_counts[(int) $child->id()] ?? 0;
    if ($count > 0) {
      $children[] = _psmhydraulics_category_card($entity_repository->getTranslationFromContext($child), $count);
    }
  }

  $description = '';
  if ($term->hasField('description') && !$term->get('description')->isEmpty()) {
    $description = (string) $term->get('description')->processed;
  }

  $quote_tags = [];
  $variables['category_view'] = [
    'crumbs' => $crumbs,
    'eyebrow' => (string) t('Category'),
    'title' => $term->label(),
    'description' => $description,
    'bg_url' => _psmhydraulics_category_image_url($term, 'wide'),
    'total' => $subtree_counts[$tid] ?? 0,
    'children' => $children,
    'refine_url' => Url::fromRoute('view.products.page_1', [], ['query' => ['category' => [$tid]]])->toString(),
    'products_url' => Url::fromRoute('view.products.page_1')->toString(),
    'quote' => _psmhydraulics_quote_link($quote_tags),
  ];

  // The band and cards read term names, images and the tree shape.
  $variables['#cache']['tags'][] = 'taxonomy_term_list:product_category';
}
